<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework, Nullable, ImplicitUsings, TreatWarningsAsErrors come from Directory.Build.props. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ForzaTelemetry.Core\ForzaTelemetry.Core.csproj" />
    <ProjectReference Include="..\ForzaTelemetry.Udp\ForzaTelemetry.Udp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      This is the composition root: unlike ForzaTelemetry.Udp (abstractions only), the console app
      is where a concrete logging backend actually gets chosen and wired up. Serilog.Sinks.Console
      + Serilog.Sinks.File give the user both a live view and a shareable log file; Serilog.Extensions.Logging
      is the bridge that lets a Serilog logger be exposed as an ordinary Microsoft.Extensions.Logging
      ILoggerFactory/ILogger<T>, which is the type ForzaTelemetry.Udp's public API expects.
    -->
    <!-- Versions are centrally managed in the root Directory.Packages.props. -->
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

</Project>
