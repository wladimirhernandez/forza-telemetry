<Project Sdk="Microsoft.NET.Sdk">

  <!-- Nullable, ImplicitUsings, TreatWarningsAsErrors come from Directory.Build.props. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Overrides the root net10.0: WPF only exists on Windows, so this project needs the -windows TFM. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>ForzaTelemetry.App</RootNamespace>
    <!-- English is the neutral resource language (a Spanish satellite assembly can be added later). -->
    <NeutralLanguage>en</NeutralLanguage>
    <!-- Declares per-monitor DPI awareness (see app.manifest for why). -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <PropertyGroup Label="Identity">
    <!--
      What Windows shows for the exe: the Explorer icon, the file properties, the installer's add/remove entry.
      The icon is the same file the installer uses (installer\assets\app.ico), so the two cannot drift apart.
    -->
    <ApplicationIcon>..\..\installer\assets\app.ico</ApplicationIcon>

    <!--
      The product name is a WORKING TITLE (the Forza trademark is not meant to be the final name). It lives in two places only:
      here, for the file properties, and the AppTitle string in Resources\Strings*.resx, for everything the user sees inside the
      app. The file description follows this property, so a rename here covers the Task Manager entry too.
    -->
    <Product>Forza Telemetry</Product>
    <AssemblyTitle>$(Product)</AssemblyTitle>

    <!--
      0.1.0 is only the default for a plain `dotnet build`. installer\build.ps1 (and the release workflow) pass -p:Version=x.y.z
      from the release tag, which overrides this; the app reads it back at run time (AppInfo.Version) for the About card and the log.
    -->
    <Version>0.1.0</Version>

    <!--
      Placeholders on purpose, matching the LICENSE and the installer: the owner fills in the real name once, and the release
      workflow's placeholder guard refuses to publish while any of these remain. Angle brackets are escaped for XML.
    -->
    <Company>&lt;COPYRIGHT HOLDER&gt;</Company>
    <Copyright>Copyright (c) 2026 &lt;COPYRIGHT HOLDER&gt;</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- Versions are centrally managed in the root Directory.Packages.props. -->
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <!--
      Same logging stack as ForzaTelemetry.Console: Serilog writes the file, Serilog.Extensions.Logging exposes it as
      the ILogger<T> that ForzaTelemetry.Udp expects. This project is the composition root, so it is where the
      concrete backend is chosen.
    -->
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The window and title-bar icon, loaded at run time as a WPF resource (pack URI). The same .ico the exe is stamped with by
      ApplicationIcon above; linked, not copied, so there is one file. It is embedded in the assembly, so the window shows its
      icon with nothing extra to install.
    -->
    <Resource Include="..\..\installer\assets\app.ico" Link="Resources\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- The bundled real car names (see CarCatalog); the logical name is pinned so the code can find it. -->
    <EmbeddedResource Include="Resources\CarCatalog.fh6.json" LogicalName="ForzaTelemetry.App.Resources.CarCatalog.fh6.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the test project reach internal helpers (AtomicFile, the system-culture capture) without making them public API. -->
    <InternalsVisibleTo Include="ForzaTelemetry.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reused unchanged: the shared telemetry parsing and UDP listener the console app already uses. -->
    <ProjectReference Include="..\ForzaTelemetry.Core\ForzaTelemetry.Core.csproj" />
    <ProjectReference Include="..\ForzaTelemetry.Udp\ForzaTelemetry.Udp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Strongly typed accessor ForzaTelemetry.App.Resources.Strings for {x:Static res:Strings.Key}. It is a committed
      file: the build-time generator works for plain compilation, but its output is not part of the WPF markup-compile
      pass, so XAML could not see the type. Add a property here whenever a key is added to Strings.resx.
    -->
    <Compile Update="Resources\Strings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Resources\Strings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
