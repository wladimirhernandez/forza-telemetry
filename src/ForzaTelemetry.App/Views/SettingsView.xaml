<UserControl x:Class="ForzaTelemetry.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:ForzaTelemetry.App"
             xmlns:res="clr-namespace:ForzaTelemetry.App.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:SettingsViewModel}"
             d:DesignWidth="1300" d:DesignHeight="760">
    <UserControl.Resources>
        <!--
          One numbered step of the in-game guide. A ContentControl whose Content is the step text and whose Tag is the number
          shown in the round badge (Tag is a free general-purpose slot, the same trick the status pills use for their dot).
        -->
        <Style x:Key="GuideStep" TargetType="ContentControl">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Margin" Value="0,12,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="24" Height="24" CornerRadius="12" VerticalAlignment="Top" Margin="0,-1,12,0"
                                    Background="{StaticResource CardRaisedBrush}" BorderBrush="{StaticResource HairlineBrush}"
                                    BorderThickness="1">
                                <TextBlock Text="{TemplateBinding Tag}" Style="{StaticResource MutedLabel}" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ContentPresenter Grid.Column="1">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                        <Setter Property="FontSize" Value="14" />
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                        <Setter Property="LineHeight" Value="20" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedLabel}">
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>

    </UserControl.Resources>

    <!--
      A ScrollViewer makes the page scroll when the window is shorter than the cards (the minimum window is 800 high).
      Focusable=False so the page itself is not an extra Tab stop; the mouse wheel and keyboard scrolling from inside the
      page still work. Two columns: the connection setup (the part new users need) on the wide left, the small preferences
      stacked on the right.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Grid Margin="28,6,28,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--
              Shown only when the settings file could not be read at startup: nothing is saved this run, so the page says it instead
              of letting changes quietly vanish. Amber like the other "not fatal" warnings; a polite live region so a screen reader
              announces it when the page opens.
            -->
            <Border Grid.Row="0" Grid.ColumnSpan="3" Style="{StaticResource CardStyle}" Margin="0,0,0,14"
                    Visibility="{Binding IsPersistenceSuspended, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="{Binding PersistenceWarning}" AutomationProperties.LiveSetting="Polite">
                <TextBlock Text="{Binding PersistenceWarning}" Foreground="{StaticResource WarmBrush}" FontSize="14"
                           TextWrapping="Wrap" />
            </Border>

            <!-- ===== Connection ===== -->
            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardStyle}" VerticalAlignment="Top"
                    AutomationProperties.Name="{x:Static res:Strings.ConnectionTitle}">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.ConnectionTitle}" Style="{StaticResource SectionTitle}" />

                    <!-- Reopens the first-run guide (live checklist) at any time. -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static res:SetupStrings.SetupGuideHint}" Style="{StaticResource SmallNote}"
                                   VerticalAlignment="Center" Margin="0,0,16,0" />
                        <Button Grid.Column="1" Style="{StaticResource FormButton}" Command="{Binding OpenSetupGuideCommand}"
                                Content="{x:Static res:SetupStrings.SetupOpenGuideButton}" />
                    </Grid>

                    <TextBlock Text="{x:Static res:Strings.PortLabel}" Style="{StaticResource FieldLabel}" />
                    <StackPanel Orientation="Horizontal">
                        <!--
                          Tag carries "has an error" into the TextBox template (red border). UpdateSourceTrigger=PropertyChanged
                          pushes every keystroke to the view model so the message appears while typing (the default,
                          LostFocus, would only validate after leaving the box). Enter applies, like pressing the button.
                        -->
                        <TextBox x:Name="PortBox" Width="140" MaxLength="5" Style="{StaticResource InputTextBox}"
                                 Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="{Binding HasPortError}"
                                 InputScope="Number"
                                 PreviewTextInput="OnPortPreviewTextInput"
                                 AutomationProperties.Name="{x:Static res:Strings.PortLabel}"
                                 AutomationProperties.HelpText="{Binding PortHint}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding ApplyPortCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Style="{StaticResource PrimaryButton}" Height="{StaticResource ControlHeight}" Padding="20,0"
                                Margin="10,0,0,0" Command="{Binding ApplyPortCommand}"
                                Content="{x:Static res:Strings.PortApplyButton}" />
                    </StackPanel>
                    <TextBlock Text="{Binding PortError}" Style="{StaticResource SmallNote}" Foreground="{StaticResource BrakeBrush}"
                               Margin="0,8,0,0"
                               Visibility="{Binding HasPortError, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding PortHint}" Style="{StaticResource SmallNote}" Margin="0,8,0,0" />

                    <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="0,22,0,22" />

                    <TextBlock Text="{x:Static res:Strings.GuideTitle}" Style="{StaticResource SectionTitle}" />

                    <!--
                      Public-network warning. Shown only while Windows reports the network of the address above as Public (the
                      installer's firewall rule covers Private networks only, so this is the usual "set up right, nothing
                      arrives" cause). The amber left edge and icon mark it as a warning without turning the whole card red;
                      the steps reuse the numbered GuideStep style. "Check again" re-reads the profile after the user changed it.
                    -->
                    <Border Background="{StaticResource CardRaisedBrush}" BorderBrush="{StaticResource WarmBrush}"
                            BorderThickness="3,1,1,1" CornerRadius="12" Padding="18,16" Margin="0,16,0,0"
                            AutomationProperties.Name="{x:Static res:Strings.PublicNetworkTitle}"
                            Visibility="{Binding DataOut.IsPublicNetwork, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <!-- Warning triangle with an exclamation mark, in the same 24 x 24 outline style as the page icons. -->
                                <Path Data="M 12,3.5 L 21.5,20 H 2.5 Z M 12,10 V 14.5 M 12,17.2 V 17.3" Stroke="{StaticResource WarmBrush}"
                                      StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static res:Strings.PublicNetworkTitle}" Style="{StaticResource ValueText}"
                                           FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{x:Static res:Strings.PublicNetworkBody}" Style="{StaticResource SmallNote}" Margin="0,10,0,0" />
                            <ContentControl Style="{StaticResource GuideStep}" Tag="1" Margin="0,14,0,0" Content="{x:Static res:Strings.PublicNetworkStep1}" />
                            <ContentControl Style="{StaticResource GuideStep}" Tag="2" Content="{x:Static res:Strings.PublicNetworkStep2}" />
                            <ContentControl Style="{StaticResource GuideStep}" Tag="3" Content="{x:Static res:Strings.PublicNetworkStep3}" />
                            <TextBlock Text="{x:Static res:Strings.PublicNetworkInstallerNote}" Style="{StaticResource SmallNote}" Margin="0,14,0,0" />
                            <Button Style="{StaticResource FormButton}" Margin="0,14,0,0" Command="{Binding DataOut.RefreshNetworkCategoryCommand}"
                                    Content="{x:Static res:Strings.PublicNetworkRecheckButton}" />
                        </StackPanel>
                    </Border>

                    <!-- This PC's address and port, with the copy button, always visible above the steps. -->
                    <Border Background="{StaticResource CardRaisedBrush}" BorderBrush="{StaticResource HairlineBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{x:Static res:Strings.DataOutIpLabel}" Style="{StaticResource SmallNote}" />
                                <TextBlock Text="{Binding DataOut.Address}" Style="{StaticResource NumeralText}" FontSize="24"
                                           TextWrapping="Wrap" Margin="0,2,0,0" />
                                <TextBlock Style="{StaticResource SmallNote}" Margin="0,4,0,0">
                                    <Run Text="{x:Static res:Strings.PortLabel}" />
                                    <Run Text="{Binding DataOut.Port, Mode=OneWay}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource FormButton}" VerticalAlignment="Center"
                                    Command="{Binding DataOut.CopyAddressCommand}"
                                    AutomationProperties.Name="{x:Static res:Strings.CopyIpTooltip}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource CopyIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.3" StrokeLineJoin="Round" Margin="0,0,9,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Static res:Strings.GuideCopyButton}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <ContentControl Style="{StaticResource GuideStep}" Tag="1" Margin="0,18,0,0" Content="{x:Static res:Strings.GuideStep1}" />
                    <ContentControl Style="{StaticResource GuideStep}" Tag="2" Content="{x:Static res:Strings.GuideStep2}" />
                    <ContentControl Style="{StaticResource GuideStep}" Tag="3" Content="{Binding GuideEndpointStep}" />

                    <TextBlock Text="{x:Static res:Strings.GuideNoteDriving}" Style="{StaticResource SmallNote}" Margin="0,20,0,0" />
                    <TextBlock Text="{Binding FirewallNote}" Style="{StaticResource SmallNote}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- ===== Preferences ===== -->
            <StackPanel Grid.Row="1" Grid.Column="2">
                <!-- Units -->
                <Border Style="{StaticResource CardStyle}" AutomationProperties.Name="{x:Static res:Strings.UnitsTitle}">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.UnitsTitle}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{x:Static res:Strings.SpeedLabel}" Style="{StaticResource FieldLabel}" />
                        <ListBox Style="{StaticResource SegmentedListBox}" ItemsSource="{Binding SpeedUnitOptions}"
                                 SelectedValue="{Binding SpeedUnit, Mode=TwoWay}"
                                 AutomationProperties.Name="{x:Static res:Strings.SpeedLabel}" />
                        <TextBlock Text="{x:Static res:Strings.UnitsTemperatureLabel}" Style="{StaticResource FieldLabel}" />
                        <ListBox Style="{StaticResource SegmentedListBox}" ItemsSource="{Binding TemperatureUnitOptions}"
                                 SelectedValue="{Binding TemperatureUnit, Mode=TwoWay}"
                                 AutomationProperties.Name="{x:Static res:Strings.UnitsTemperatureLabel}" />
                    </StackPanel>
                </Border>

                <!-- Language -->
                <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0"
                        AutomationProperties.Name="{x:Static res:Strings.LanguageTitle}">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.LanguageTitle}" Style="{StaticResource SectionTitle}" />
                        <ComboBox Style="{StaticResource DarkComboBox}" Margin="0,14,0,0"
                                  ItemsSource="{Binding LanguageOptions}" SelectedValue="{Binding Language, Mode=TwoWay}"
                                  AutomationProperties.Name="{x:Static res:Strings.LanguageTitle}" />
                        <!-- Shown only after a different language was picked: texts already on screen keep the old one until the app restarts. -->
                        <StackPanel Visibility="{Binding LanguageChangePending, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{x:Static res:Strings.LanguageRestartNote}" Style="{StaticResource SmallNote}" Margin="0,10,0,0" />
                            <Button Style="{StaticResource FormButton}" Margin="0,12,0,0" Command="{Binding RestartCommand}"
                                    Content="{x:Static res:Strings.RestartButton}"
                                    Visibility="{Binding CanRestart, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Startup -->
                <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0"
                        AutomationProperties.Name="{x:Static res:Strings.StartupTitle}">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.StartupTitle}" Style="{StaticResource SectionTitle}" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{x:Static res:Strings.StartListeningOnLaunchLabel}" Foreground="{StaticResource TextBrush}"
                                           FontSize="14" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Static res:Strings.StartListeningOnLaunchHint}" Style="{StaticResource SmallNote}" Margin="0,3,0,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding StartListeningOnLaunch, Mode=TwoWay}"
                                      AutomationProperties.Name="{x:Static res:Strings.StartListeningOnLaunchLabel}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Diagnostics -->
                <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0"
                        AutomationProperties.Name="{x:Static res:Strings.DiagnosticsTitle}">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.DiagnosticsTitle}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{x:Static res:Strings.DiagnosticsHint}" Style="{StaticResource SmallNote}" Margin="0,10,0,0" />
                        <Button Style="{StaticResource FormButton}" Margin="0,14,0,0" Command="{Binding OpenLogsFolderCommand}"
                                Content="{x:Static res:Strings.OpenLogsButton}" />
                        <TextBlock Text="{Binding LogDirectory}" Style="{StaticResource SmallNote}" FontSize="11" Margin="0,10,0,0"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding LogDirectory}" />
                    </StackPanel>
                </Border>

                <!-- About -->
                <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0"
                        AutomationProperties.Name="{x:Static res:Strings.AboutTitle}">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.AboutTitle}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding AppName}" Style="{StaticResource ValueText}" FontSize="22" FontWeight="SemiBold"
                                   Margin="0,14,0,0" />
                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource MutedLabel}" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding LicenseText}" Style="{StaticResource SmallNote}" Margin="0,12,0,0" />
                        <TextBlock Text="{x:Static res:Strings.AboutDisclaimer}" Style="{StaticResource SmallNote}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
