<UserControl x:Class="ForzaTelemetry.App.Views.LapsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:ForzaTelemetry.App"
             xmlns:res="clr-namespace:ForzaTelemetry.App.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:LapsViewModel}"
             d:DesignWidth="1300" d:DesignHeight="700">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource MutedLabel}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ColumnHeader" TargetType="TextBlock" BasedOn="{StaticResource MutedLabel}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!--
          The delta pill. Two layers in one Grid: a tinted fill and the text. The tint is the status colour at low opacity
          (Opacity on the FILL layer only, so the text stays fully opaque); both colours come from the palette tokens, and
          which one applies is decided by the view model's closed LapDeltaState, never by parsing the text.
          Green (Throttle) = ahead of the best lap, red (Brake) = behind, plain text colour = level.
        -->
        <Style x:Key="DeltaFill" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource MutedBrush}" />
            <Setter Property="Opacity" Value="0.16" />
            <Setter Property="CornerRadius" Value="22" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DeltaState}" Value="Ahead">
                    <Setter Property="Background" Value="{StaticResource ThrottleBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DeltaState}" Value="Behind">
                    <Setter Property="Background" Value="{StaticResource BrakeBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
          The three big clocks share one look: the thin numerals in the text colour, dimmed when there is nothing real to show
          (a placeholder must read as "inactive", not as a time). Each use sets the flag it dims on through its own trigger.
        -->
        <Style x:Key="BigClock" TargetType="TextBlock" BasedOn="{StaticResource NumeralText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRacing}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LastLapClock" TargetType="TextBlock" BasedOn="{StaticResource NumeralText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasLastLap}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BestLapClock" TargetType="TextBlock" BasedOn="{StaticResource NumeralText}">
            <Setter Property="Foreground" Value="{StaticResource ThrottleBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasBestLap}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A lap time in the list: thin numerals, green for the best lap (the row style, not the view model, picks the colour). -->
        <Style x:Key="LapTimeCell" TargetType="TextBlock" BasedOn="{StaticResource NumeralText}">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Normal" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBest}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource ThrottleBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DeltaText" TargetType="TextBlock" BasedOn="{StaticResource NumeralText}">
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DeltaState}" Value="Ahead">
                    <Setter Property="Foreground" Value="{StaticResource ThrottleBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DeltaState}" Value="Behind">
                    <Setter Property="Foreground" Value="{StaticResource BrakeBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,6,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Hero: the running lap clock and the live delta; beside it, last and best lap ===== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="26,20,26,22"
                    AutomationProperties.Name="{Binding HeroName}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{x:Static res:Strings.LapsCurrentTitle}" Style="{StaticResource CardTitle}" />
                        <!-- The lap number as a small outlined chip, only while racing. -->
                        <Border HorizontalAlignment="Right" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="11,3"
                                Visibility="{Binding IsRacing, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding LapNumberText}" Style="{StaticResource ValueText}" FontSize="13" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding CurrentLapText}" Style="{StaticResource BigClock}" FontSize="104"
                                   VerticalAlignment="Center" />
                        <!-- The live delta. Hidden (not just empty) when there is no reference lap, so no empty pill is drawn. -->
                        <Grid Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="28,6,0,0"
                              Visibility="{Binding HasDelta, Converter={StaticResource BoolToVisibility}}"
                              AutomationProperties.Name="{Binding DeltaName}">
                            <Border Style="{StaticResource DeltaFill}" />
                            <TextBlock Text="{Binding DeltaText}" Style="{StaticResource DeltaText}" Margin="22,4,22,6" />
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="22,20"
                    AutomationProperties.Name="{x:Static res:Strings.LapsLastTitle}">
                <StackPanel VerticalAlignment="Top">
                    <TextBlock Text="{x:Static res:Strings.LapsLastTitle}" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="{Binding LastLapText}" Style="{StaticResource LastLapClock}" FontSize="46" Margin="0,14,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="22,20"
                    AutomationProperties.Name="{x:Static res:Strings.LapsBestTitle}">
                <StackPanel VerticalAlignment="Top">
                    <TextBlock Text="{x:Static res:Strings.LapsBestTitle}" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="{Binding BestLapText}" Style="{StaticResource BestLapClock}" FontSize="46" Margin="0,14,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== The session's laps ===== -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="22,16,22,8" Margin="0,14,0,0"
                AutomationProperties.Name="{x:Static res:Strings.LapsListTitle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{x:Static res:Strings.LapsListTitle}" Style="{StaticResource SectionTitle}" />

                <!-- Column headers; the widths are repeated in the row template below and must stay identical. -->
                <Grid Grid.Row="1" Margin="0,14,0,6" Visibility="{Binding HasLaps, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Static res:Strings.LapsColLap}" Style="{StaticResource ColumnHeader}" />
                    <TextBlock Grid.Column="1" Text="{x:Static res:Strings.LapsColTime}" Style="{StaticResource ColumnHeader}" />
                    <TextBlock Grid.Column="2" Text="{x:Static res:Strings.LapsColDelta}" Style="{StaticResource ColumnHeader}" />
                </Grid>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False" Margin="0,0,0,8">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding Rows}" IsTabStop="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:LapRow}">
                                    <!-- The best lap gets a raised background and a green time; the others are plain rows. -->
                                    <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="0,10"
                                            AutomationProperties.Name="{Binding Summary}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBest}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource CardRaisedBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding NumberText}" Margin="12,0,0,0" Style="{StaticResource MutedLabel}"
                                                       FontSize="15" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding TimeText}" Style="{StaticResource LapTimeCell}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding DeltaText}" Style="{StaticResource MutedLabel}" FontSize="15"
                                                       VerticalAlignment="Center" />
                                            <!-- "Best" tag instead of a delta for the fastest lap. -->
                                            <Border Grid.Column="3" HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center"
                                                    Background="{StaticResource ThrottleBrush}" CornerRadius="10" Padding="9,2"
                                                    Visibility="{Binding IsBest, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{x:Static res:Strings.LapsBestTag}" Foreground="{StaticResource CanvasBrush}"
                                                           FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty state, shown instead of an empty list. -->
                        <TextBlock Text="{Binding EmptyText}" Style="{StaticResource MutedLabel}" FontSize="14" TextWrapping="Wrap"
                                   TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460"
                                   LineHeight="21" Margin="0,40"
                                   Visibility="{Binding HasEmptyText, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
