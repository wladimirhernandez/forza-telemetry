<UserControl x:Class="ForzaTelemetry.App.Views.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:ForzaTelemetry.App"
             xmlns:controls="clr-namespace:ForzaTelemetry.App.Controls"
             xmlns:res="clr-namespace:ForzaTelemetry.App.Resources"
             mc:Ignorable="d"
             d:DesignWidth="1300" d:DesignHeight="700">
    <!--
      The Map page: header with the Clear button, the map in a card (with an empty state sharing its cell) and a strip
      of three session statistics. The DataContext is a MapViewModel.
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="StatTile" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="18,12" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource NumeralText}">
            <Setter Property="FontSize" Value="30" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,18,28,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="18,0" Height="{StaticResource ControlHeight}"
                    Content="{x:Static res:InsightsStrings.MapClear}" Command="{Binding ClearCommand}"
                    ToolTip="{x:Static res:InsightsStrings.MapClearTooltip}"
                    AutomationProperties.Name="{x:Static res:InsightsStrings.MapClearTooltip}" />
            <TextBlock Text="{x:Static res:InsightsStrings.MapTitle}" Style="{StaticResource ValueText}"
                       FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,14,0,14" Padding="0"
                AutomationProperties.Name="{x:Static res:InsightsStrings.MapChartName}">
            <Grid>
                <controls:TrackMap Points="{Binding Points}" PointCount="{Binding PointCount}" DataVersion="{Binding DataVersion}"
                                   MinSpeedMs="{Binding MinSpeedMs}" MaxSpeedMs="{Binding MaxSpeedMs}"
                                   CurrentX="{Binding CurrentX}" CurrentZ="{Binding CurrentZ}" HasCurrent="{Binding HasCurrent}"
                                   ViewState="{Binding ViewState}"
                                   SpeedScale="{Binding SpeedScale}" SpeedUnit="{Binding SpeedUnitLabel}"
                                   Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}" />

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <Border Width="72" Height="72" CornerRadius="{StaticResource PillRadius}" HorizontalAlignment="Center"
                            Background="{StaticResource CardRaisedBrush}" BorderBrush="{StaticResource HairlineBrush}"
                            BorderThickness="1">
                        <Viewbox Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="{Binding Source={x:Static local:PageIcons.Map}}"
                                      Stroke="{StaticResource MutedBrush}" StrokeThickness="1.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <TextBlock Text="{x:Static res:InsightsStrings.MapEmptyTitle}" Style="{StaticResource ValueText}"
                               FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,0" />
                    <TextBlock Text="{x:Static res:InsightsStrings.MapEmptyHint}" Style="{StaticResource MutedLabel}"
                               FontSize="14" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" LineHeight="21" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource StatTile}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="{x:Static res:InsightsStrings.MapDistance}" Style="{StaticResource MutedLabel}" />
                    <TextBlock Text="{Binding DistanceText}" Style="{StaticResource StatValue}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource StatTile}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="{x:Static res:InsightsStrings.MapTopSpeed}" Style="{StaticResource MutedLabel}" />
                    <TextBlock Text="{Binding TopSpeedText}" Style="{StaticResource StatValue}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource StatTile}">
                <StackPanel>
                    <TextBlock Text="{x:Static res:InsightsStrings.MapBrakingZones}" Style="{StaticResource MutedLabel}" />
                    <TextBlock Text="{Binding BrakingZones}" Style="{StaticResource StatValue}"
                               Foreground="{StaticResource BrakeBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
