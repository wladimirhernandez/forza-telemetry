<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ForzaTelemetry.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="720"
             x:Class="ForzaTelemetry.App.Views.MainView"
             x:DataType="vm:MainViewModel">
    <Design.DataContext>
        <!-- Sample values for the IDE previewer only (MainViewModel's parameterless constructor
             fills them in) — the REAL DataContext is set at runtime in App.axaml.cs. -->
        <vm:MainViewModel />
    </Design.DataContext>

    <!--
      A Grid with star-sized ("*"/"Auto") rows, not fixed pixel heights: every "*" row takes an equal
      SHARE of whatever height is available, so this exact same layout reflows correctly whether the
      window is a wide desktop window or a tall portrait phone screen (Android, later) — no separate
      layout is needed per form factor. "Auto" rows (the bar, pkt/s, status, buttons) just take
      however much height their own content needs.
    -->
    <Grid RowDefinitions="2*,1*,Auto,Auto,Auto,Auto" Margin="24">
        <!-- Gear: the single biggest thing on screen — glanceable at a distance while driving. -->
        <TextBlock Grid.Row="0"
                   Text="{Binding GearLabel}"
                   FontSize="140"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />

        <!--
          StringFormat ("{}{0:F0} km/h") lives HERE, in the view, not in the view model.
          MainViewModel exposes a plain float (SpeedKmh) with no display formatting baked in — the
          VIEW decides how to present it (rounding to whole km/h, adding the unit suffix). That keeps
          the view model UI-framework-agnostic and reusable behind a different view (e.g. a future
          Android layout) that might want to format the very same number differently.
        -->
        <TextBlock Grid.Row="1"
                   Text="{Binding SpeedKmh, StringFormat='{}{0:F0} km/h'}"
                   FontSize="64"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />

        <!-- RPM bar: Maximum is BOUND to MaxRpm, not a hardcoded number — different cars in FH6 have
             very different redlines, so a fixed Maximum would make the bar meaningless for most cars. -->
        <StackPanel Grid.Row="2" Spacing="4" Margin="0,8,0,16">
            <ProgressBar Minimum="0"
                         Maximum="{Binding MaxRpm}"
                         Value="{Binding Rpm}"
                         Height="24" />
            <TextBlock Text="{Binding Rpm, StringFormat='{}{0:F0} RPM'}"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <TextBlock Grid.Row="3"
                   Text="{Binding PacketsPerSecond, StringFormat='{}{0:F1} pkt/s'}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8" />

        <TextBlock Grid.Row="4"
                   Text="{Binding Status}"
                   HorizontalAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16" />

        <!--
          Two separate buttons, not one toggle button: each Button.Command binds to exactly one
          RelayCommand, and Avalonia automatically enables/disables a bound Button from that
          command's CanExecute (see MainViewModel's CanStart/CanStop) — clicking Start while already
          running, or Stop while stopped, is simply not possible, without either button's own
          Content/meaning ever needing to change.
        -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
            <Button Content="Start" Command="{Binding StartCommand}" />
            <Button Content="Stop" Command="{Binding StopCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
