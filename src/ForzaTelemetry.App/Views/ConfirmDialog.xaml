<Window x:Class="ForzaTelemetry.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="464"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FocusManager.FocusedElement="{Binding ElementName=CancelButton}">
    <!--
      A themed modal question, used instead of the OS MessageBox so a destructive confirmation looks like the rest of the app
      (a light Windows dialog over a dark window is jarring) and its buttons carry our labels and focus rules. Same borderless
      technique as the main window, minus the resize band: a transparent margin around a rounded card that holds the shadow.
      The SAFE button (Cancel) is the default: it has the focus, so Enter and Escape both mean "do nothing"; deleting takes a
      deliberate Tab or click onto the red button.
    -->
    <Border Margin="{StaticResource ChromeMargin}" Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
            CornerRadius="{StaticResource CardRadius}" Padding="26,24,26,22"
            TextElement.Foreground="{StaticResource TextBrush}" TextElement.FontFamily="{StaticResource LabelFont}"
            MouseLeftButtonDown="OnDragMouseDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.6" Color="Black" />
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="TitleText" Style="{StaticResource ValueText}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="MessageText" Style="{StaticResource MutedLabel}" FontSize="14" LineHeight="21"
                       TextWrapping="Wrap" Margin="0,10,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <!-- Destructive: outlined with a red label so it is clearly the dangerous one, never the filled green primary. -->
                <Button x:Name="ConfirmButton" Style="{StaticResource GhostButton}" Foreground="{StaticResource BrakeBrush}"
                        Height="{StaticResource ControlHeight}" Padding="18,0" Click="OnConfirmClick" />
                <Button x:Name="CancelButton" Style="{StaticResource PrimaryButton}" Height="{StaticResource ControlHeight}"
                        Padding="20,0" Margin="10,0,0,0" IsCancel="True" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
