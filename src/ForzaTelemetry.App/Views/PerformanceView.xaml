<UserControl x:Class="ForzaTelemetry.App.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:ForzaTelemetry.App"
             xmlns:res="clr-namespace:ForzaTelemetry.App.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:PerformanceViewModel}"
             d:DesignWidth="1300" d:DesignHeight="700">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!--
          A result card: the app's card surface that turns green-edged while its Tag is True. Tag is the general-purpose slot every
          element has (the status pills use it for their dot color the same way); here it carries the card's "new best" flag, so
          one style serves the four cards and the view model needs no per-card color property.
        -->
        <Style x:Key="ResultCard" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="22,18,22,16" />
            <Style.Triggers>
                <!-- A DataTrigger, not a Trigger: Tag is typed object, so a plain Trigger would compare the bool with the TEXT "True"
                     and never fire; a DataTrigger converts "True" to the type of the value it reads. -->
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource ThrottleBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The small green "New best" tag in a card's corner. -->
        <Style x:Key="NewBestTag" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ThrottleBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="9,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <Style x:Key="ResultTitle" TargetType="TextBlock" BasedOn="{StaticResource MutedLabel}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ResultCaption" TargetType="TextBlock" BasedOn="{StaticResource MutedLabel}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="18" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style x:Key="SmallNote" TargetType="TextBlock" BasedOn="{StaticResource MutedLabel}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="18" />
        </Style>

        <Style x:Key="FormButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Height" Value="{StaticResource ControlHeight}" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--
          A table header that sorts. Flat (no box) so the header row reads as a header, not a row of buttons; muted until it is
          the sorted column or the mouse is over it. The marker (a small chevron) is drawn only for the sorted column: each
          header sets its own marker's visibility from the view model's IsSortedBy... flag.
        -->
        <Style x:Key="TableHeaderButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource LabelFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="0,6">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The sort chevron inside a header; pass the visibility with a binding at the use site. -->
        <Style x:Key="SortMarker" TargetType="Path">
            <Setter Property="Data" Value="M 0,0 L 4,4 L 8,0" />
            <Setter Property="Stroke" Value="{StaticResource TextBrush}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Margin" Value="6,1,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,6,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== State bar: what the timer is doing now, the car, and the reset button ===== -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="20,10" MinHeight="64"
                AutomationProperties.Name="{x:Static res:Strings.TabPerformance}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Dot: colour by state. Muted while waiting or ready, green once armed or done, amber while timing, red when aborted. -->
                    <Ellipse Width="10" Height="10" Margin="0,2,12,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource MutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Armed">
                                        <Setter Property="Fill" Value="{StaticResource ThrottleBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Done">
                                        <Setter Property="Fill" Value="{StaticResource ThrottleBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Running">
                                        <Setter Property="Fill" Value="{StaticResource WarmBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Aborted">
                                        <Setter Property="Fill" Value="{StaticResource BrakeBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StateText}" Style="{StaticResource ValueText}" FontSize="17" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="{Binding ElapsedText}" Style="{StaticResource NumeralText}" FontSize="24"
                               Foreground="{StaticResource WarmBrush}" Margin="16,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!--
                      The current car as separate pills, never one string joined with a separator: the car (or "no car detected
                      yet"), then, once there is a car, class + index + drivetrain exactly like the top bar's car pill.
                      AutomationProperties.Name only reaches assistive technology from an element that has an automation peer,
                      and a plain StackPanel has none, so the whole car sentence is the NAME OF THE FIRST PILL (a ContentControl
                      is a Control). WPF has no way to hide the second pill from assistive technology, so a screen reader may also
                      read its three fragments after the sentence; the sentence is what carries the meaning.
                    -->
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Style="{StaticResource StatusPill}" Tag="{x:Null}" Content="{Binding CarText}"
                                        AutomationProperties.Name="{Binding CarSummary}" />
                        <ContentControl Style="{StaticResource StatusPill}" Margin="10,0,0,0" Tag="{x:Null}"
                                        Visibility="{Binding HasCar, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding CarClassLabel}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding CarPerformanceIndex, StringFormat={x:Static res:Strings.CarPerformanceIndexFormat}}"
                                           Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0" />
                                <TextBlock Text="{Binding DrivetrainLabel}" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0" />
                            </StackPanel>
                        </ContentControl>
                    </StackPanel>
                    <Button Style="{StaticResource FormButton}" Margin="10,0,0,0" Command="{Binding ResetRunCommand}"
                            Content="{x:Static res:Strings.PerfResetRun}" ToolTip="{x:Static res:Strings.PerfResetRunTooltip}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== The four result cards ===== -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 0-100 km/h -->
            <Border Grid.Column="0" Style="{StaticResource ResultCard}" Tag="{Binding ZeroTo100IsNewBest}"
                    AutomationProperties.Name="{Binding ZeroTo100Name}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{x:Static res:Strings.PerfTitle100}" Style="{StaticResource ResultTitle}" />
                        <Border Style="{StaticResource NewBestTag}"
                                Visibility="{Binding ZeroTo100IsNewBest, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{x:Static res:Strings.PerfNewBest}" Foreground="{StaticResource CanvasBrush}"
                                       FontSize="11" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource NumeralText}" FontSize="64">
                        <Run Text="{Binding ZeroTo100Text, Mode=OneWay}" /><Run Text=" s" FontFamily="{StaticResource LabelFont}"
                             FontSize="20" FontWeight="Normal" Foreground="{StaticResource MutedBrush}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource ResultCaption}" />
                </StackPanel>
            </Border>

            <!-- 0-200 km/h -->
            <Border Grid.Column="2" Style="{StaticResource ResultCard}" Tag="{Binding ZeroTo200IsNewBest}"
                    AutomationProperties.Name="{Binding ZeroTo200Name}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{x:Static res:Strings.PerfTitle200}" Style="{StaticResource ResultTitle}" />
                        <Border Style="{StaticResource NewBestTag}"
                                Visibility="{Binding ZeroTo200IsNewBest, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{x:Static res:Strings.PerfNewBest}" Foreground="{StaticResource CanvasBrush}"
                                       FontSize="11" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource NumeralText}" FontSize="64">
                        <Run Text="{Binding ZeroTo200Text, Mode=OneWay}" /><Run Text=" s" FontFamily="{StaticResource LabelFont}"
                             FontSize="20" FontWeight="Normal" Foreground="{StaticResource MutedBrush}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource ResultCaption}" />
                </StackPanel>
            </Border>

            <!-- Quarter mile, with the speed at the line underneath -->
            <Border Grid.Column="4" Style="{StaticResource ResultCard}" Tag="{Binding QuarterMileIsNewBest}"
                    AutomationProperties.Name="{Binding QuarterMileName}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{x:Static res:Strings.PerfTitleQuarter}" Style="{StaticResource ResultTitle}" />
                        <Border Style="{StaticResource NewBestTag}"
                                Visibility="{Binding QuarterMileIsNewBest, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{x:Static res:Strings.PerfNewBest}" Foreground="{StaticResource CanvasBrush}"
                                       FontSize="11" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource NumeralText}" FontSize="64">
                        <Run Text="{Binding QuarterMileText, Mode=OneWay}" /><Run Text=" s" FontFamily="{StaticResource LabelFont}"
                             FontSize="20" FontWeight="Normal" Foreground="{StaticResource MutedBrush}" />
                    </TextBlock>
                    <TextBlock Text="{Binding QuarterMileTrapText}" Style="{StaticResource ResultCaption}" />
                </StackPanel>
            </Border>

            <!-- Top speed, in the chosen unit -->
            <Border Grid.Column="6" Style="{StaticResource ResultCard}" Tag="{Binding TopSpeedIsNewBest}"
                    AutomationProperties.Name="{Binding TopSpeedName}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{x:Static res:Strings.PerfTitleTopSpeed}" Style="{StaticResource ResultTitle}" />
                        <Border Style="{StaticResource NewBestTag}"
                                Visibility="{Binding TopSpeedIsNewBest, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{x:Static res:Strings.PerfNewBest}" Foreground="{StaticResource CanvasBrush}"
                                       FontSize="11" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource NumeralText}" FontSize="64">
                        <Run Text="{Binding TopSpeedText, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding SpeedUnitLabel, Mode=OneWay}"
                             FontFamily="{StaticResource LabelFont}" FontSize="20" FontWeight="Normal"
                             Foreground="{StaticResource MutedBrush}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource ResultCaption}" />
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2">
            <!-- Shown while the numbers on screen come from a replay: they are measured and displayed, never saved. -->
            <TextBlock Text="{x:Static res:Strings.PerfReplayNote}" Style="{StaticResource SmallNote}" Margin="4,10,4,0"
                       Visibility="{Binding IsReplaySession, Converter={StaticResource BoolToVisibility}}" />

            <!-- Shown only in mph: the runs are still timed to 100 and 200 km/h. -->
            <TextBlock Text="{x:Static res:Strings.PerfThresholdNote}" Style="{StaticResource SmallNote}" Margin="4,10,4,0"
                       Visibility="{Binding ShowThresholdNote, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <!-- ===== Best per car ===== -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="22,16,22,8" Margin="0,14,0,0"
                AutomationProperties.Name="{x:Static res:Strings.PerfHistoryTitle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock Text="{x:Static res:Strings.PerfHistoryTitle}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource FormButton}" HorizontalAlignment="Right" Command="{Binding ClearHistoryCommand}"
                            Content="{x:Static res:Strings.PerfClearHistory}" />
                </Grid>

                <!-- Header row: each header sorts by its column. A Grid cannot share ColumnDefinitions between instances, so the
                     column widths are repeated in the row template below: keep them identical or the headers drift off their data. -->
                <Grid Grid.Row="1" Margin="0,12,0,0" Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.3*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="1.5*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource TableHeaderButton}"
                            Command="{Binding SortByCommand}" CommandParameter="{x:Static local:PerformanceSortColumn.Car}"
                            AutomationProperties.Name="{x:Static res:Strings.PerfColCar}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static res:Strings.PerfColCar}" />
                            <Path Style="{StaticResource SortMarker}" Visibility="{Binding IsSortedByCar, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Style="{StaticResource TableHeaderButton}"
                            Command="{Binding SortByCommand}" CommandParameter="{x:Static local:PerformanceSortColumn.ZeroTo100}"
                            AutomationProperties.Name="{x:Static res:Strings.PerfColZeroTo100}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static res:Strings.PerfColZeroTo100}" />
                            <Path Style="{StaticResource SortMarker}" Visibility="{Binding IsSortedByZeroTo100, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource TableHeaderButton}"
                            Command="{Binding SortByCommand}" CommandParameter="{x:Static local:PerformanceSortColumn.ZeroTo200}"
                            AutomationProperties.Name="{x:Static res:Strings.PerfColZeroTo200}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static res:Strings.PerfColZeroTo200}" />
                            <Path Style="{StaticResource SortMarker}" Visibility="{Binding IsSortedByZeroTo200, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource TableHeaderButton}"
                            Command="{Binding SortByCommand}" CommandParameter="{x:Static local:PerformanceSortColumn.QuarterMile}"
                            AutomationProperties.Name="{x:Static res:Strings.PerfColQuarter}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static res:Strings.PerfColQuarter}" />
                            <Path Style="{StaticResource SortMarker}" Visibility="{Binding IsSortedByQuarterMile, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="4" Style="{StaticResource TableHeaderButton}"
                            Command="{Binding SortByCommand}" CommandParameter="{x:Static local:PerformanceSortColumn.TopSpeed}"
                            AutomationProperties.Name="{x:Static res:Strings.PerfColTopSpeed}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static res:Strings.PerfColTopSpeed}" />
                            <Path Style="{StaticResource SortMarker}" Visibility="{Binding IsSortedByTopSpeed, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="5" Style="{StaticResource TableHeaderButton}"
                            Command="{Binding SortByCommand}" CommandParameter="{x:Static local:PerformanceSortColumn.Recent}"
                            AutomationProperties.Name="{x:Static res:Strings.PerfColUpdated}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static res:Strings.PerfColUpdated}" />
                            <Path Style="{StaticResource SortMarker}" Visibility="{Binding IsSortedByRecent, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Rows. The list scrolls inside the card when there are more cars than fit. -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                              Margin="0,0,0,8">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding Rows}" IsTabStop="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:CarPerformanceRow}">
                                    <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="0,10"
                                            AutomationProperties.Name="{Binding Summary}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.3*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="1.3*" />
                                                <ColumnDefinition Width="1.5*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <!-- Green dot: this is the car being driven now. Reserved width keeps the names aligned. -->
                                                <Ellipse Width="8" Height="8" Margin="0,2,10,0" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="Transparent" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrentCar}" Value="True">
                                                                    <Setter Property="Fill" Value="{StaticResource ThrottleBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding CarLabel}" Style="{StaticResource ValueText}" FontSize="15" FontWeight="SemiBold" />
                                                    <!-- Class and index as one muted line; the drivetrain is its own small tag, not text joined on. -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <TextBlock Style="{StaticResource MutedLabel}" FontSize="12" VerticalAlignment="Center">
                                                            <Run Text="{Binding ClassLabel, Mode=OneWay}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                                                            <Run Text="{Binding PerformanceIndexText, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="8"
                                                                Padding="6,0" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DrivetrainLabel}" Style="{StaticResource MutedLabel}" FontSize="11" />
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding ZeroTo100Text}" Style="{StaticResource ValueText}" FontSize="15" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding ZeroTo200Text}" Style="{StaticResource ValueText}" FontSize="15" VerticalAlignment="Center" />
                                            <!-- Time on the first line, the speed at the line muted underneath (collapsed when there is none). -->
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding QuarterMileText}" Style="{StaticResource ValueText}" FontSize="15" />
                                                <TextBlock Text="{Binding QuarterMileTrapText}" FontSize="12" Margin="0,1,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedLabel}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding QuarterMileTrapText}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="4" Text="{Binding TopSpeedText}" Style="{StaticResource ValueText}" FontSize="15" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="5" Text="{Binding UpdatedText}" Style="{StaticResource MutedLabel}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty state, shown instead of an empty table. -->
                        <TextBlock Text="{x:Static res:Strings.PerfHistoryEmpty}" FontSize="14"
                                   TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   MaxWidth="460" LineHeight="21" Margin="0,24">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedLabel}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasHistory}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
