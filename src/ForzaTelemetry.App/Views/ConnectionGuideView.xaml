<UserControl x:Class="ForzaTelemetry.App.Views.ConnectionGuideView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:ForzaTelemetry.App"
             xmlns:res="clr-namespace:ForzaTelemetry.App.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:ConnectionGuideViewModel}"
             d:DesignWidth="1300" d:DesignHeight="800"
             IsVisibleChanged="OnIsVisibleChanged">
    <!--
      The "Connect your game" guide: a modal card over the whole window (the host places this control over every row of the
      window grid and shows it while ConnectionGuideViewModel.IsOpen). The scrim swallows mouse input so nothing underneath can be
      clicked; Esc closes. Two columns: what to type (left) and the live checklist with whatever extra help the state calls for
      (right). Every state change comes from the view model, so there is no logic here beyond mapping states to icons.
    -->
    <UserControl.Resources>
        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource LabelFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="20" />
        </Style>

        <!-- One numbered in-game step (the same badge look as the Settings guide). Tag carries the number. -->
        <Style x:Key="GuideStep" TargetType="ContentControl">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Margin" Value="0,12,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="24" Height="24" CornerRadius="12" VerticalAlignment="Top" Margin="0,-1,12,0"
                                    Background="{StaticResource CardRaisedBrush}" BorderBrush="{StaticResource HairlineBrush}"
                                    BorderThickness="1">
                                <TextBlock Text="{TemplateBinding Tag}" Style="{StaticResource MutedLabel}" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ContentPresenter Grid.Column="1">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}" />
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          A checklist line: a state icon, the title, and the sentence under it. The icon is three stacked shapes, one visible per
          state (pending: hollow ring; ok: filled green with a tick; warning: amber triangle), chosen by DataTriggers on State.
          The icon is decorative (IsHitTestVisible/automation off): the whole line carries one spoken name that includes the state
          as a word, so the meaning never depends on color.
        -->
        <DataTemplate DataType="{x:Type local:ChecklistStepViewModel}">
            <Grid Margin="0,0,0,16" AutomationProperties.Name="{Binding AutomationName}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="24" Height="24" VerticalAlignment="Top" Margin="0,0,14,0" AutomationProperties.Name="{x:Null}">
                    <Ellipse Width="20" Height="20" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.6">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Pending">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Ok">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Ellipse Width="20" Height="20" Fill="{StaticResource ThrottleBrush}" />
                        <Path Data="M 7.2,12.4 L 10.4,15.4 L 16.6,8.8" Stroke="{StaticResource CanvasBrush}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Grid>
                    <Path Data="M 12,3.5 L 21.5,20 H 2.5 Z M 12,10 V 14.5 M 12,17.2 V 17.3" Stroke="{StaticResource WarmBrush}"
                          StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Warning">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Grid>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource SmallNote}" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    </UserControl.InputBindings>

    <!-- Scrim: the window canvas color at high opacity, so the app is still faintly there but nothing in it competes. -->
    <Grid>
        <Grid.Background>
            <SolidColorBrush Color="{StaticResource CanvasColor}" Opacity="0.9" />
        </Grid.Background>

        <Border Style="{StaticResource CardStyle}" Padding="0" Margin="40,36" Width="980" VerticalAlignment="Center"
                HorizontalAlignment="Center"
                AutomationProperties.Name="{x:Static res:SetupStrings.SetupTitle}"
                KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Margin="32,26,22,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{x:Static res:SetupStrings.SetupTitle}" Style="{StaticResource ValueText}" FontSize="24"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{x:Static res:SetupStrings.SetupSubtitle}" Style="{StaticResource MutedLabel}" FontSize="14"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource WindowGlyphButton}" VerticalAlignment="Top"
                            Command="{Binding CloseCommand}" ToolTip="{x:Static res:SetupStrings.SetupCloseButton}"
                            AutomationProperties.Name="{x:Static res:SetupStrings.SetupCloseButton}">
                        <Path Data="{StaticResource CloseIcon}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <Grid Margin="32,22,32,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="1.1*" />
                        </Grid.ColumnDefinitions>

                        <!-- ===== Left: what to type ===== -->
                        <StackPanel>
                            <Border Background="{StaticResource CardRaisedBrush}" BorderBrush="{StaticResource HairlineBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="20,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{x:Static res:SetupStrings.SetupAddressLabel}" Style="{StaticResource SmallNote}" />
                                        <TextBlock Text="{Binding DataOut.Address}" Style="{StaticResource NumeralText}" FontSize="34"
                                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                                        <TextBlock Text="{x:Static res:SetupStrings.SetupPortLabel}" Style="{StaticResource SmallNote}"
                                                   Margin="0,12,0,0" />
                                        <TextBlock Text="{Binding DataOut.Port}" Style="{StaticResource NumeralText}" FontSize="34"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource FormButton}" VerticalAlignment="Top"
                                            Command="{Binding DataOut.CopyAddressCommand}"
                                            AutomationProperties.Name="{x:Static res:SetupStrings.SetupCopyButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource CopyIcon}"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.3" StrokeLineJoin="Round" Margin="0,0,9,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Static res:SetupStrings.SetupCopyButton}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <TextBlock Text="{x:Static res:SetupStrings.SetupWhichIpTitle}" Style="{StaticResource SectionTitle}" Margin="0,24,0,0" />
                            <TextBlock Text="{x:Static res:SetupStrings.SetupSamePcTitle}" Style="{StaticResource BodyText}"
                                       FontWeight="SemiBold" Margin="0,12,0,0" />
                            <TextBlock Text="{x:Static res:SetupStrings.SetupSamePcBody}" Style="{StaticResource SmallNote}" Margin="0,2,0,0" />
                            <TextBlock Text="{x:Static res:SetupStrings.SetupOtherDeviceTitle}" Style="{StaticResource BodyText}"
                                       FontWeight="SemiBold" Margin="0,12,0,0" />
                            <TextBlock Text="{x:Static res:SetupStrings.SetupOtherDeviceBody}" Style="{StaticResource SmallNote}" Margin="0,2,0,0" />

                            <TextBlock Text="{x:Static res:SetupStrings.SetupInGameTitle}" Style="{StaticResource SectionTitle}" Margin="0,24,0,0" />
                            <ContentControl Style="{StaticResource GuideStep}" Tag="1" Margin="0,14,0,0"
                                            Content="{x:Static res:SetupStrings.SetupInGameStep1}" />
                            <ContentControl Style="{StaticResource GuideStep}" Tag="2" Content="{x:Static res:SetupStrings.SetupInGameStep2}" />
                            <ContentControl Style="{StaticResource GuideStep}" Tag="3" Content="{x:Static res:SetupStrings.SetupInGameStep3}" />
                        </StackPanel>

                        <!-- ===== Right: live checklist and the help the current state calls for ===== -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{x:Static res:SetupStrings.SetupChecklistTitle}" Style="{StaticResource SectionTitle}" />
                            <ItemsControl ItemsSource="{Binding Steps}" Margin="0,16,0,0" IsTabStop="False" Focusable="False" />

                            <Button Style="{StaticResource PrimaryButton}" Height="{StaticResource ControlHeight}" Padding="22,0"
                                    HorizontalAlignment="Left" Margin="0,2,0,0" Command="{Binding StartListeningCommand}"
                                    Content="{Binding StartListeningLabel}"
                                    Visibility="{Binding CanStartListening, Converter={StaticResource BoolToVisibility}}" />

                            <!-- Public network: the usual reason that "everything is set up and nothing arrives". -->
                            <Border Background="{StaticResource CardRaisedBrush}" BorderBrush="{StaticResource WarmBrush}"
                                    BorderThickness="3,1,1,1" CornerRadius="12" Padding="18,14" Margin="0,18,0,0"
                                    AutomationProperties.Name="{x:Static res:SetupStrings.SetupNetworkFixTitle}"
                                    Visibility="{Binding ShowNetworkFix, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="{x:Static res:SetupStrings.SetupNetworkFixTitle}" Style="{StaticResource BodyText}"
                                               FontWeight="SemiBold" />
                                    <ContentControl Style="{StaticResource GuideStep}" Tag="1" Margin="0,12,0,0"
                                                    Content="{x:Static res:Strings.PublicNetworkStep1}" />
                                    <ContentControl Style="{StaticResource GuideStep}" Tag="2" Content="{x:Static res:Strings.PublicNetworkStep2}" />
                                    <ContentControl Style="{StaticResource GuideStep}" Tag="3" Content="{x:Static res:Strings.PublicNetworkStep3}" />
                                    <Button Style="{StaticResource FormButton}" Margin="0,14,0,0"
                                            Command="{Binding DataOut.RefreshNetworkCategoryCommand}"
                                            Content="{x:Static res:Strings.PublicNetworkRecheckButton}" />
                                </StackPanel>
                            </Border>

                            <!-- Listening a while with nothing arriving: the usual causes, most likely first. -->
                            <Border Background="{StaticResource CardRaisedBrush}" BorderBrush="{StaticResource WarmBrush}"
                                    BorderThickness="3,1,1,1" CornerRadius="12" Padding="18,14" Margin="0,18,0,0"
                                    AutomationProperties.Name="{x:Static res:SetupStrings.SetupTroubleTitle}"
                                    Visibility="{Binding ShowTroubleshooting, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="{x:Static res:SetupStrings.SetupTroubleTitle}" Style="{StaticResource BodyText}"
                                               FontWeight="SemiBold" />
                                    <ContentControl Style="{StaticResource GuideStep}" Tag="1" Margin="0,12,0,0"
                                                    Content="{x:Static res:SetupStrings.SetupTroubleIp}" />
                                    <ContentControl Style="{StaticResource GuideStep}" Tag="2" Content="{x:Static res:SetupStrings.SetupTroubleFirewall}" />
                                    <ContentControl Style="{StaticResource GuideStep}" Tag="3" Content="{x:Static res:SetupStrings.SetupTroubleVpn}" />
                                    <ContentControl Style="{StaticResource GuideStep}" Tag="4" Content="{x:Static res:SetupStrings.SetupTroubleSubnet}" />
                                    <ContentControl Style="{StaticResource GuideStep}" Tag="5" Content="{x:Static res:SetupStrings.SetupTroubleDriving}" />
                                </StackPanel>
                            </Border>

                            <!-- Done. LiveSetting=Polite: a screen reader announces it when it appears, without stealing focus. -->
                            <Border Background="{StaticResource CardRaisedBrush}" BorderBrush="{StaticResource ThrottleBrush}"
                                    BorderThickness="3,1,1,1" CornerRadius="12" Padding="18,16" Margin="0,18,0,0"
                                    AutomationProperties.LiveSetting="Polite"
                                    AutomationProperties.Name="{x:Static res:SetupStrings.SetupConnectedTitle}"
                                    Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="{x:Static res:SetupStrings.SetupConnectedTitle}" Style="{StaticResource ValueText}"
                                               FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource ThrottleBrush}" />
                                    <TextBlock Text="{x:Static res:SetupStrings.SetupConnectedBody}" Style="{StaticResource SmallNote}"
                                               Margin="0,4,0,0" />
                                    <Button x:Name="GoToDashboardButton" Style="{StaticResource PrimaryButton}"
                                            Height="{StaticResource ControlHeight}" Padding="22,0" HorizontalAlignment="Left"
                                            Margin="0,14,0,0" Command="{Binding GoToDashboardCommand}"
                                            Content="{x:Static res:SetupStrings.SetupGoToDashboard}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- Footer -->
                <Button Grid.Row="2" Style="{StaticResource FormButton}" HorizontalAlignment="Right" Margin="32,12,32,24"
                        Command="{Binding CloseCommand}" Content="{x:Static res:SetupStrings.SetupCloseButton}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
