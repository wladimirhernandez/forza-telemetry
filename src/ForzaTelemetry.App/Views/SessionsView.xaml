<UserControl x:Class="ForzaTelemetry.App.Views.SessionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:ForzaTelemetry.App"
             xmlns:res="clr-namespace:ForzaTelemetry.App.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:SessionsViewModel}"
             d:DesignWidth="1300" d:DesignHeight="700"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <!-- A small muted caption above a value (Duration, Size, Packets) and the value itself in the numeral face. -->
        <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedLabel}">
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource NumeralText}">
            <Setter Property="FontSize" Value="30" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <!--
          Record / Stop recording. Idle it is an outlined button with a red dot (ready, not alarming); while recording it turns
          into a filled red button with a stop square. A DataTrigger on the view model's IsRecording swaps the Template and
          the icon, the same technique as the Start/Stop toggle in the top bar.
        -->
        <Style x:Key="RecordButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="176" />
            <Setter Property="Padding" Value="22,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="AutomationProperties.Name" Value="{x:Static res:SessionsStrings.SessionsRecordButton}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                    <Setter Property="AutomationProperties.Name" Value="{x:Static res:SessionsStrings.SessionsStopRecordingButton}" />
                    <Setter Property="Template" Value="{StaticResource DangerButtonTemplate}" />
                    <Setter Property="Foreground" Value="{StaticResource CanvasBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Round play/pause button of the player. -->
        <Style x:Key="PlayerPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- The pill-shaped tags of a row (Incomplete, Unreadable). -->
        <Style x:Key="RowTag" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,6,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Record panel ===== -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="22,18"
                AutomationProperties.Name="{x:Static res:SessionsStrings.SessionsRecordTitle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static res:SessionsStrings.SessionsRecordTitle}" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                    <!-- ShowOnDisabled: a disabled button is where the explanation (start listening first) matters most. -->
                    <Button Style="{StaticResource RecordButton}" Command="{Binding ToggleRecordingCommand}"
                            ToolTip="{Binding RecordTooltip}" ToolTipService.ShowOnDisabled="True">
                        <StackPanel Orientation="Horizontal">
                            <Path Margin="0,0,10,0" VerticalAlignment="Center" Stretch="None">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="{StaticResource RecordIcon}" />
                                        <Setter Property="Fill" Value="{StaticResource BrakeBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                <Setter Property="Data" Value="{StaticResource StopIcon}" />
                                                <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{x:Static res:SessionsStrings.SessionsRecordButton}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                <Setter Property="Text" Value="{x:Static res:SessionsStrings.SessionsStopRecordingButton}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Grid Grid.Column="1" Margin="36,0,0,0" VerticalAlignment="Center">
                    <!-- Idle: what recording is for. -->
                    <TextBlock Text="{x:Static res:SessionsStrings.SessionsRecordHint}" FontSize="14" TextWrapping="Wrap" LineHeight="21"
                               MaxWidth="560" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedLabel}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Recording: live numbers. The StackPanel is one thing to a screen reader through the three captions below. -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"
                                Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel MinWidth="170">
                            <TextBlock Text="{x:Static res:SessionsStrings.SessionsStatDuration}" Style="{StaticResource StatLabel}" />
                            <TextBlock Text="{Binding RecordingDurationText}" Style="{StaticResource StatValue}" />
                        </StackPanel>
                        <StackPanel MinWidth="170">
                            <TextBlock Text="{x:Static res:SessionsStrings.SessionsStatSize}" Style="{StaticResource StatLabel}" />
                            <TextBlock Text="{Binding RecordingSizeText}" Style="{StaticResource StatValue}" />
                        </StackPanel>
                        <StackPanel MinWidth="170">
                            <TextBlock Text="{x:Static res:SessionsStrings.SessionsStatPackets}" Style="{StaticResource StatLabel}" />
                            <TextBlock Text="{Binding RecordingPacketsText}" Style="{StaticResource StatValue}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Warnings and results, under both columns: amber for "the disk cannot keep up", red for a failure, quiet for "saved". -->
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
                    <TextBlock Text="{Binding DroppedWarning}" Foreground="{StaticResource WarmBrush}" FontSize="13" TextWrapping="Wrap"
                               Margin="0,12,0,0" Visibility="{Binding HasDroppedWarning, Converter={StaticResource BoolToVisibility}}"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="{Binding RecordingError}" Foreground="{StaticResource BrakeBrush}" FontSize="13" TextWrapping="Wrap"
                               Margin="0,12,0,0" Visibility="{Binding HasRecordingError, Converter={StaticResource BoolToVisibility}}"
                               AutomationProperties.LiveSetting="Assertive" />
                    <TextBlock Text="{Binding Notice}" FontSize="13" TextWrapping="Wrap" Margin="0,12,0,0"
                               Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}"
                               AutomationProperties.LiveSetting="Polite">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedLabel}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NoticeIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource BrakeBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Player: only while a recording is replaying ===== -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="22,16" Margin="0,14,0,0"
                Visibility="{Binding IsReplaying, Converter={StaticResource BoolToVisibility}}"
                AutomationProperties.Name="{x:Static res:SessionsStrings.SessionsPlayerTitle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" Margin="0,2,12,0" Fill="{StaticResource ColdBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Static res:SessionsStrings.SessionsPlayerTitle}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding PlayerTitle}" Style="{StaticResource ValueText}" FontSize="16" Margin="14,0,0,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="520" />
                        <!-- State pill: Playing, Paused or Finished. A live region: it is announced when it changes. -->
                        <Border Style="{StaticResource RowTag}" Margin="14,0,0,0">
                            <TextBlock Text="{Binding PlayerStateText}" Style="{StaticResource MutedLabel}" FontSize="12"
                                       AutomationProperties.LiveSetting="Polite" />
                        </Border>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource FormButton}" Command="{Binding StopReplayCommand}"
                            ToolTip="{x:Static res:SessionsStrings.SessionsStopReplayTooltip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource StopIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stretch="None" Margin="0,0,9,0" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static res:SessionsStrings.SessionsStopReplay}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource WindowGlyphButton}" Width="40" Height="40" Command="{Binding RestartCommand}"
                            ToolTip="{x:Static res:SessionsStrings.SessionsRestartTooltip}"
                            AutomationProperties.Name="{x:Static res:SessionsStrings.SessionsRestart}">
                        <Path Data="{StaticResource RestartIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="None" />
                    </Button>

                    <Button Grid.Column="1" Style="{StaticResource PlayerPrimaryButton}" Margin="6,0,0,0" Command="{Binding PlayPauseCommand}"
                            ToolTip="{Binding PlayPauseLabel}" AutomationProperties.Name="{Binding PlayPauseLabel}">
                        <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="None">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Data" Value="{StaticResource PlayIcon}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsShowingPause}" Value="True">
                                            <Setter Property="Data" Value="{StaticResource PauseIcon}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="22,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{x:Static res:SessionsStrings.SessionsSpeedLabel}" Style="{StaticResource MutedLabel}" VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <ListBox Style="{StaticResource SegmentedListBox}" ItemsSource="{Binding SpeedOptions}"
                                 SelectedValue="{Binding SelectedSpeed, Mode=TwoWay}"
                                 AutomationProperties.Name="{x:Static res:SessionsStrings.SessionsSpeedName}" />
                    </StackPanel>

                    <ProgressBar Grid.Column="3" Style="{StaticResource ThinProgressBar}" Margin="26,0,18,0" VerticalAlignment="Center"
                                 Foreground="{StaticResource ColdBrush}" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}"
                                 AutomationProperties.Name="{x:Static res:SessionsStrings.SessionsProgressName}" />

                    <TextBlock Grid.Column="4" Text="{Binding PositionText}" Style="{StaticResource ValueText}" FontSize="15" MinWidth="96"
                               TextAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>

        <!-- ===== Library ===== -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="22,16,22,8" Margin="0,14,0,0"
                AutomationProperties.Name="{x:Static res:SessionsStrings.SessionsLibraryTitle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- A recording is being converted to CSV: what and how far, and a way out. Only while it runs. -->
                <Border Grid.Row="1" Margin="0,12,0,0" Padding="16,12" CornerRadius="10" Background="{StaticResource CardRaisedBrush}"
                        Visibility="{Binding IsExporting, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding ExportText}" Style="{StaticResource ValueText}" FontSize="13" TextTrimming="CharacterEllipsis" />
                            <ProgressBar Style="{StaticResource ThinProgressBar}" Margin="0,9,0,0" Foreground="{StaticResource ColdBrush}"
                                         Minimum="0" Maximum="1" Value="{Binding ExportProgress, Mode=OneWay}"
                                         AutomationProperties.Name="{x:Static res:ExportStrings.ExportProgressName}" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource FormButton}" Margin="18,0,0,0" VerticalAlignment="Center"
                                Command="{Binding CancelExportCommand}" Content="{x:Static res:Strings.CancelButton}"
                                ToolTip="{x:Static res:ExportStrings.ExportCancelTooltip}" />
                    </Grid>
                </Border>

                <Grid Grid.Row="0">
                    <TextBlock Text="{x:Static res:SessionsStrings.SessionsLibraryTitle}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource FormButton}" HorizontalAlignment="Right" Command="{Binding OpenFolderCommand}"
                            ToolTip="{x:Static res:SessionsStrings.SessionsOpenFolderTooltip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource FolderIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.3" StrokeLineJoin="Round" Stretch="None" Margin="0,0,9,0" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static res:SessionsStrings.SessionsOpenFolder}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Column captions. The widths repeat the row template below: keep them identical or the captions drift off their data. -->
                <Grid Grid.Row="2" Margin="0,14,0,4" Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="250" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Static res:SessionsStrings.SessionsColRecording}" Style="{StaticResource MutedLabel}" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{x:Static res:SessionsStrings.SessionsColDuration}" Style="{StaticResource MutedLabel}" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="{x:Static res:SessionsStrings.SessionsColSize}" Style="{StaticResource MutedLabel}" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="{x:Static res:SessionsStrings.SessionsColCars}" Style="{StaticResource MutedLabel}" FontSize="12" FontWeight="SemiBold" />
                </Grid>

                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                              Margin="0,0,0,8">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding Rows}" IsTabStop="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:RecordingRowViewModel}">
                                    <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="0,10"
                                            AutomationProperties.Name="{Binding Summary}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="250" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Name cell: the name and its date, or the rename box with its message. -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Cold dot: this is the recording being replayed now. Reserved width keeps the names aligned. -->
                                                <Ellipse Width="8" Height="8" Margin="0,2,10,0" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="Transparent" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                                    <Setter Property="Fill" Value="{StaticResource ColdBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="320">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource ValueText}">
                                                                    <Setter Property="FontSize" Value="15" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <Border Style="{StaticResource RowTag}" ToolTip="{x:Static res:SessionsStrings.SessionsTruncatedTooltip}"
                                                                Visibility="{Binding IsTruncated, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock Text="{x:Static res:SessionsStrings.SessionsTruncated}" Style="{StaticResource MutedLabel}" FontSize="11" />
                                                        </Border>
                                                        <Border Style="{StaticResource RowTag}" ToolTip="{x:Static res:SessionsStrings.SessionsUnreadableTooltip}"
                                                                Visibility="{Binding IsUnreadable, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock Text="{x:Static res:SessionsStrings.SessionsUnreadable}" Foreground="{StaticResource WarmBrush}" FontSize="11" />
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- Rename box: Enter saves, Esc cancels (KeyBindings on the box, commands on the row), a lost focus cancels. -->
                                                    <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBox Style="{StaticResource InputTextBox}" Width="320" HorizontalAlignment="Left"
                                                                 Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                                                 Tag="{Binding HasEditError}"
                                                                 AutomationProperties.Name="{Binding NameBoxName}"
                                                                 IsVisibleChanged="OnRenameBoxVisibleChanged" LostKeyboardFocus="OnRenameBoxLostFocus">
                                                            <TextBox.InputBindings>
                                                                <KeyBinding Key="Enter" Command="{Binding CommitRenameCommand}" />
                                                                <KeyBinding Key="Escape" Command="{Binding CancelRenameCommand}" />
                                                            </TextBox.InputBindings>
                                                        </TextBox>
                                                        <TextBlock FontSize="12" Margin="2,5,0,0" TextWrapping="Wrap" MaxWidth="360"
                                                                   AutomationProperties.LiveSetting="Polite">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedLabel}">
                                                                    <Setter Property="Text" Value="{x:Static res:SessionsStrings.SessionsRenameHint}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasEditError}" Value="True">
                                                                            <Setter Property="Text" Value="{Binding EditError}" />
                                                                            <Setter Property="Foreground" Value="{StaticResource BrakeBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <TextBlock Text="{Binding StartedText}" Style="{StaticResource MutedLabel}" FontSize="12" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" Text="{Binding DurationText}" Style="{StaticResource ValueText}" FontSize="15" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource ValueText}" FontSize="15" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding CarsText}" Style="{StaticResource ValueText}" FontSize="15" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />

                                            <!-- Actions. Rename and Delete are disabled (with a tooltip that says why) for the recording playing now. -->
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button Style="{StaticResource GhostButton}" Height="32" Padding="14,0" Command="{Binding PlayCommand}"
                                                        AutomationProperties.Name="{Binding PlayName}" ToolTip="{x:Static res:SessionsStrings.SessionsPlay}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource PlayIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              Stretch="Uniform" Width="9" Height="10" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{x:Static res:SessionsStrings.SessionsPlay}" FontSize="13" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource WindowGlyphButton}" Margin="6,0,0,0" Command="{Binding BeginRenameCommand}"
                                                        IsEnabled="{Binding CanModify}" ToolTip="{Binding RenameTooltip}" ToolTipService.ShowOnDisabled="True"
                                                        AutomationProperties.Name="{Binding RenameName}">
                                                    <Path Data="{StaticResource PencilIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="1.3" StrokeLineJoin="Round" Stretch="None" />
                                                </Button>
                                                <Button Style="{StaticResource WindowGlyphButton}" Margin="2,0,0,0" Command="{Binding ExportCommand}"
                                                        ToolTip="{Binding ExportTooltip}" ToolTipService.ShowOnDisabled="True"
                                                        AutomationProperties.Name="{Binding ExportName}">
                                                    <Path Data="{StaticResource ExportIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="1.3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="None" />
                                                </Button>
                                                <Button Style="{StaticResource CloseGlyphButton}" Margin="2,0,0,0" Command="{Binding DeleteCommand}"
                                                        IsEnabled="{Binding CanModify}" ToolTip="{Binding DeleteTooltip}" ToolTipService.ShowOnDisabled="True"
                                                        AutomationProperties.Name="{Binding DeleteName}">
                                                    <Path Data="{StaticResource TrashIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="1.3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="None" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty state, shown instead of an empty list. -->
                        <TextBlock Text="{x:Static res:SessionsStrings.SessionsEmpty}" FontSize="14" TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" LineHeight="21" Margin="0,40"
                                   Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedLabel}" />
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{x:Static res:SessionsStrings.SessionsLoading}" FontSize="14" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Margin="0,40"
                                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedLabel}" />
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
