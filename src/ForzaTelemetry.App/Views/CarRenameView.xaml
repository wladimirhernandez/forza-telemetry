<UserControl x:Class="ForzaTelemetry.App.Views.CarRenameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:ForzaTelemetry.App"
             xmlns:res="clr-namespace:ForzaTelemetry.App.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:CarRenameViewModel}"
             d:DesignWidth="1300" d:DesignHeight="800"
             IsVisibleChanged="OnIsVisibleChanged">
    <!--
      The "Name car #1234" box: a small modal card over the window (the host places this control over every row and shows it while
      CarRenameViewModel.IsOpen). One box serves every "rename" button of the app. Enter saves, Esc cancels (both are key bindings on the
      text box, where the focus is while typing), and the message under the box follows the typing.
    -->

    <Grid>
        <Grid.Background>
            <SolidColorBrush Color="{StaticResource CanvasColor}" Opacity="0.82" />
        </Grid.Background>

        <Border Style="{StaticResource CardStyle}" Width="460" Padding="26,24,26,22" VerticalAlignment="Center"
                HorizontalAlignment="Center" AutomationProperties.Name="{Binding Title}"
                KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource ValueText}" FontSize="18" FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock Text="{x:Static res:CarNameStrings.CarRenameHint}" Style="{StaticResource MutedLabel}" FontSize="13"
                           LineHeight="19" TextWrapping="Wrap" Margin="0,8,0,0" />

                <!-- Tag carries "has an error" into the text box template (red border); every keystroke reaches the view model. There is
                     deliberately no MaxLength: it would silently cut pasted text, while the view model counts the TRIMMED name and says
                     "too long" (Save stays disabled), so the player sees what is wrong and nothing is ever dropped without notice. -->
                <TextBox x:Name="NameBox" Style="{StaticResource InputTextBox}" Margin="0,16,0,0"
                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding HasError}"
                         AutomationProperties.Name="{x:Static res:CarNameStrings.CarRenameBoxName}"
                         AutomationProperties.HelpText="{Binding Error}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SaveCommand}" />
                        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock Text="{Binding Error}" Style="{StaticResource MutedLabel}" FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource BrakeBrush}" Margin="0,8,0,0"
                           AutomationProperties.LiveSetting="Polite"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

                <Grid Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource FormButton}" HorizontalAlignment="Left" Command="{Binding UseDefaultCommand}"
                            Content="{x:Static res:CarNameStrings.CarRenameUseDefault}"
                            Visibility="{Binding HasNickname, Converter={StaticResource BoolToVisibility}}" />
                    <Button Grid.Column="1" Style="{StaticResource FormButton}" Command="{Binding CancelCommand}"
                            Content="{x:Static res:CarNameStrings.CarRenameCancel}" />
                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Height="{StaticResource ControlHeight}"
                            Padding="22,0" Margin="10,0,0,0" Command="{Binding SaveCommand}"
                            Content="{x:Static res:CarNameStrings.CarRenameSave}" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
