<UserControl x:Class="ForzaTelemetry.App.Views.TuningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:ForzaTelemetry.App"
             xmlns:controls="clr-namespace:ForzaTelemetry.App.Controls"
             xmlns:res="clr-namespace:ForzaTelemetry.App.Resources"
             mc:Ignorable="d"
             d:DesignWidth="1300" d:DesignHeight="700">
    <!--
      The Tuning page. Left: the dyno chart for the car being driven. Right (scrolls when the window is short): three
      compact cards, balance, suspension and tires. The DataContext is a TuningViewModel.
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- A bottoming counter: the numeral turns amber for occasional hits and red for frequent ones. Tag carries the severity (0/1/2). -->
        <Style x:Key="CounterValue" TargetType="TextBlock" BasedOn="{StaticResource NumeralText}">
            <Setter Property="FontSize" Value="26" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="1">
                    <Setter Property="Foreground" Value="{StaticResource WarmBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="2">
                    <Setter Property="Foreground" Value="{StaticResource BrakeBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Tire temperature dot, same cold/ideal/warm/hot colors as the dashboard's tires. Tag carries the TireTempBand. -->
        <Style x:Key="BandDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{StaticResource HairlineBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="Cold">
                    <Setter Property="Fill" Value="{StaticResource ColdBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="Ideal">
                    <Setter Property="Fill" Value="{StaticResource ThrottleBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="Warm">
                    <Setter Property="Fill" Value="{StaticResource WarmBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="Hot">
                    <Setter Property="Fill" Value="{StaticResource BrakeBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A small raised tile used for the 2 x 2 corner grids. -->
        <Style x:Key="CornerTile" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardRaisedBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="3" />
        </Style>

        <Style x:Key="TempValue" TargetType="TextBlock" BasedOn="{StaticResource NumeralText}">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}" />

        <Style x:Key="AdviceText" TargetType="TextBlock" BasedOn="{StaticResource MutedLabel}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="19" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="CardButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,18,28,18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.7*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="1*" MinWidth="330" />
        </Grid.ColumnDefinitions>

        <!-- ===== Dyno ===== -->
        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="22,18,22,12"
                AutomationProperties.Name="{x:Static res:InsightsStrings.DynoChartName}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource CardButton}" VerticalAlignment="Top"
                            Content="{x:Static res:InsightsStrings.DynoReset}" Command="{Binding ResetDynoCommand}"
                            ToolTip="{x:Static res:InsightsStrings.DynoResetTooltip}"
                            AutomationProperties.Name="{x:Static res:InsightsStrings.DynoResetTooltip}" />
                    <StackPanel>
                        <TextBlock Text="{x:Static res:InsightsStrings.DynoTitle}" Style="{StaticResource CardTitle}" FontSize="20" />
                        <TextBlock Margin="0,3,0,0" Style="{StaticResource MutedLabel}">
                            <Run Text="{Binding CarLabel, Mode=OneWay}" /><Run Text="  &#183;  " /><Run Text="{x:Static res:InsightsStrings.DynoHint}" />
                        </TextBlock>
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <controls:DynoChart Curve="{Binding Curve}" CurveVersion="{Binding CurveVersion}"
                                        Visibility="{Binding HasCurve, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="400"
                                Visibility="{Binding HasNoCurve, Converter={StaticResource BoolToVisibility}}">
                        <Border Width="64" Height="64" CornerRadius="{StaticResource PillRadius}" HorizontalAlignment="Center"
                                Background="{StaticResource CardRaisedBrush}" BorderBrush="{StaticResource HairlineBrush}"
                                BorderThickness="1">
                            <Viewbox Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{Binding Source={x:Static local:PageIcons.Tuning}}"
                                          Stroke="{StaticResource MutedBrush}" StrokeThickness="1.4"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="{x:Static res:InsightsStrings.DynoEmptyTitle}" Style="{StaticResource ValueText}"
                                   FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0" />
                        <TextBlock Text="{x:Static res:InsightsStrings.DynoEmptyHint}" Style="{StaticResource MutedLabel}"
                                   FontSize="14" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" LineHeight="21" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ===== Insight cards ===== -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel>
                <!-- Balance -->
                <Border Style="{StaticResource CardStyle}" Padding="18,14" AutomationProperties.Name="{x:Static res:InsightsStrings.BalanceTitle}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding BalanceLabel}" Style="{StaticResource ValueText}"
                                       FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static res:InsightsStrings.BalanceTitle}" Style="{StaticResource CardTitle}" />
                        </DockPanel>
                        <controls:BalanceBar Height="30" Margin="0,14,0,0" Value="{Binding BalanceValue}" IsActive="{Binding BalanceActive}"
                                             IsHitTestVisible="False"
                                             AutomationProperties.Name="{x:Static res:InsightsStrings.BalanceBarName}" />
                        <DockPanel Margin="0,4,0,0" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Right" Text="{x:Static res:InsightsStrings.BalanceUndersteer}" Style="{StaticResource MutedLabel}" FontSize="12" />
                            <TextBlock DockPanel.Dock="Left" Text="{x:Static res:InsightsStrings.BalanceOversteer}" Style="{StaticResource MutedLabel}" FontSize="12" />
                        </DockPanel>
                        <TextBlock Text="{Binding BalanceAdvice}" Style="{StaticResource AdviceText}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- Suspension -->
                <Border Style="{StaticResource CardStyle}" Padding="18,14" Margin="0,12,0,0"
                        AutomationProperties.Name="{x:Static res:InsightsStrings.SuspensionTitle}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource CardButton}"
                                    Content="{x:Static res:InsightsStrings.SuspensionReset}" Command="{Binding ResetBottomingCommand}"
                                    ToolTip="{x:Static res:InsightsStrings.SuspensionResetTooltip}"
                                    AutomationProperties.Name="{x:Static res:InsightsStrings.SuspensionResetTooltip}" />
                            <TextBlock Text="{x:Static res:InsightsStrings.SuspensionTitle}" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{x:Static res:InsightsStrings.SuspensionHint}" Style="{StaticResource MutedLabel}" FontSize="12" Margin="0,4,0,0" />

                        <!-- One tile per corner (front left, front right, rear left, rear right). The negative margin cancels the tiles' own margin so the row lines up with the card text. -->
                        <UniformGrid Columns="4" Margin="-3,10,-3,0">
                            <Border Style="{StaticResource CornerTile}">
                                <StackPanel>
                                    <TextBlock Text="{x:Static res:InsightsStrings.CornerFrontLeft}" Style="{StaticResource MutedLabel}" FontSize="12" />
                                    <TextBlock Text="{Binding BottomFrontLeft}" Tag="{Binding SeverityFrontLeft}" Style="{StaticResource CounterValue}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CornerTile}">
                                <StackPanel>
                                    <TextBlock Text="{x:Static res:InsightsStrings.CornerFrontRight}" Style="{StaticResource MutedLabel}" FontSize="12" />
                                    <TextBlock Text="{Binding BottomFrontRight}" Tag="{Binding SeverityFrontRight}" Style="{StaticResource CounterValue}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CornerTile}">
                                <StackPanel>
                                    <TextBlock Text="{x:Static res:InsightsStrings.CornerRearLeft}" Style="{StaticResource MutedLabel}" FontSize="12" />
                                    <TextBlock Text="{Binding BottomRearLeft}" Tag="{Binding SeverityRearLeft}" Style="{StaticResource CounterValue}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CornerTile}">
                                <StackPanel>
                                    <TextBlock Text="{x:Static res:InsightsStrings.CornerRearRight}" Style="{StaticResource MutedLabel}" FontSize="12" />
                                    <TextBlock Text="{Binding BottomRearRight}" Tag="{Binding SeverityRearRight}" Style="{StaticResource CounterValue}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <TextBlock Text="{Binding SuspensionAdvice}" Style="{StaticResource AdviceText}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- Tires -->
                <Border Style="{StaticResource CardStyle}" Padding="18,14" Margin="0,12,0,0"
                        AutomationProperties.Name="{x:Static res:InsightsStrings.TiresTitle}">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:InsightsStrings.TiresTitle}" Style="{StaticResource CardTitle}" />
                        <UniformGrid Columns="4" Margin="-3,10,-3,0">
                            <Border Style="{StaticResource CornerTile}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Style="{StaticResource BandDot}" Tag="{Binding BandFrontLeft}" />
                                        <TextBlock Text="{x:Static res:InsightsStrings.CornerFrontLeft}" Style="{StaticResource MutedLabel}" FontSize="12" Margin="6,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding TempFrontLeft}" Style="{StaticResource TempValue}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CornerTile}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Style="{StaticResource BandDot}" Tag="{Binding BandFrontRight}" />
                                        <TextBlock Text="{x:Static res:InsightsStrings.CornerFrontRight}" Style="{StaticResource MutedLabel}" FontSize="12" Margin="6,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding TempFrontRight}" Style="{StaticResource TempValue}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CornerTile}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Style="{StaticResource BandDot}" Tag="{Binding BandRearLeft}" />
                                        <TextBlock Text="{x:Static res:InsightsStrings.CornerRearLeft}" Style="{StaticResource MutedLabel}" FontSize="12" Margin="6,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding TempRearLeft}" Style="{StaticResource TempValue}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CornerTile}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Style="{StaticResource BandDot}" Tag="{Binding BandRearRight}" />
                                        <TextBlock Text="{x:Static res:InsightsStrings.CornerRearRight}" Style="{StaticResource MutedLabel}" FontSize="12" Margin="6,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding TempRearRight}" Style="{StaticResource TempValue}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <ItemsControl ItemsSource="{Binding TireLines}" Margin="0,8,0,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource AdviceText}" Margin="0,2,0,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
