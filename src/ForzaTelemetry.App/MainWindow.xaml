<Window x:Class="ForzaTelemetry.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ForzaTelemetry.App"
        xmlns:views="clr-namespace:ForzaTelemetry.App.Views"
        xmlns:controls="clr-namespace:ForzaTelemetry.App.Controls"
        xmlns:res="clr-namespace:ForzaTelemetry.App.Resources"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        d:DataContext="{x:Static local:ShellViewModel.DesignSample}"
        Title="{x:Static res:Strings.AppTitle}"
        Width="1440" Height="900" MinWidth="1280" MinHeight="800"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <!--
      Borderless window technique:
      - WindowStyle=None removes the OS title bar; AllowsTransparency + Background=Transparent let the rounded
        Border below show through with real rounded corners and a soft shadow (the transparent margin around
        it is where the shadow is drawn).
      - With the OS frame gone the window loses its resize edges, so WindowChrome gives them back: CaptionHeight=0
        (our own title bar handles dragging) and ResizeBorderThickness = the same transparent margin.
      - While maximized the window fills the work area exactly, so the margin, shadow and rounded corners are
        removed and the resize band is zeroed (otherwise its 12 px would sit on top of the title bar glyph buttons).
        A Style with a Trigger on WindowState does all of that declaratively: the trigger applies its Setters while
        the window is maximized and undoes them when it is not, so no code-behind has to remember "the old values".
      - WindowStartupLocation=Manual: MainWindow centers itself on the monitor under the cursor (WPF's CenterScreen
        always uses the primary monitor).
    -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <shell:WindowChrome x:Key="NormalChrome" CaptionHeight="0" GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False" ResizeBorderThickness="{StaticResource ChromeMargin}" />
        <shell:WindowChrome x:Key="MaximizedChrome" CaptionHeight="0" GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False" ResizeBorderThickness="0" />

        <!--
          Implicit DataTemplates: a template with a DataType and NO x:Key is applied automatically to every object of that
          type shown by a ContentControl/ContentPresenter below. This is the whole screen-switching mechanism: one line per
          kind of page, mapping a view model type to the view that draws it. The view models never reference a view.
        -->
        <DataTemplate DataType="{x:Type local:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:PlaceholderPageViewModel}">
            <views:PlaceholderView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>
    <!--
      Ctrl+1..8 jump straight to a tab. KeyBindings live on the Window so they work wherever the focus is; each one runs
      the shell's NavigateCommand with the target PageId as its parameter. The digit row (D1..D8) and the numeric keypad
      (NumPad1..NumPad8) are different keys to WPF, so each shortcut is declared twice.
    -->
    <Window.InputBindings>
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="{x:Static local:PageId.Dashboard}" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="{x:Static local:PageId.Performance}" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="{x:Static local:PageId.Laps}" />
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="{x:Static local:PageId.Sessions}" />
        <KeyBinding Key="D5" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="{x:Static local:PageId.Analysis}" />
        <KeyBinding Key="D6" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="{x:Static local:PageId.Map}" />
        <KeyBinding Key="D7" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="{x:Static local:PageId.Tuning}" />
        <KeyBinding Key="D8" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="{x:Static local:PageId.Settings}" />
        <KeyBinding Key="NumPad1" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="{x:Static local:PageId.Dashboard}" />
        <KeyBinding Key="NumPad2" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="{x:Static local:PageId.Performance}" />
        <KeyBinding Key="NumPad3" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="{x:Static local:PageId.Laps}" />
        <KeyBinding Key="NumPad4" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="{x:Static local:PageId.Sessions}" />
        <KeyBinding Key="NumPad5" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="{x:Static local:PageId.Analysis}" />
        <KeyBinding Key="NumPad6" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="{x:Static local:PageId.Map}" />
        <KeyBinding Key="NumPad7" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="{x:Static local:PageId.Tuning}" />
        <KeyBinding Key="NumPad8" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="{x:Static local:PageId.Settings}" />
    </Window.InputBindings>
    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="shell:WindowChrome.WindowChrome" Value="{StaticResource NormalChrome}" />
            <Style.Triggers>
                <Trigger Property="WindowState" Value="Maximized">
                    <Setter Property="shell:WindowChrome.WindowChrome" Value="{StaticResource MaximizedChrome}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Style>

    <Border
            Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
            TextElement.Foreground="{StaticResource TextBrush}"
            TextElement.FontFamily="{StaticResource LabelFont}"
            TextElement.FontSize="14">
        <!-- Margin, CornerRadius and Effect live in this Style (not as local attributes) so the trigger can override them:
             a locally set value always beats a Style value. -->
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Margin" Value="{StaticResource ChromeMargin}" />
                <Setter Property="CornerRadius" Value="{StaticResource WindowRadius}" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.6" Color="Black" />
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                 Value="Maximized">
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="CornerRadius" Value="0" />
                        <Setter Property="Effect" Value="{x:Null}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <!--
          Window layout, three rows: title bar (fixed 52), top bar (as tall as its content) and the page area (star: takes
          everything left). The page area is ONE ContentControl whose Content is the shell view model's CurrentPage; which
          screen appears there is decided by the DataTemplates declared in Window.Resources, never by code.
          Every {Binding ...} reads a property of ShellViewModel (the DataContext set in MainWindow's constructor).
          {x:Static res:Strings.Key} reads UI text from Resources/Strings.resx (en) or Strings.es.resx at load time.
        -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar: the transparent-background Grid is what receives the mouse for dragging. -->
            <Grid Grid.Row="0" Background="Transparent" KeyboardNavigation.TabIndex="1" KeyboardNavigation.TabNavigation="Local" MouseLeftButtonDown="OnDragAreaMouseDown"
                  MouseMove="OnDragAreaMouseMove" MouseLeftButtonUp="OnDragAreaMouseUp" LostMouseCapture="OnDragAreaLostCapture">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{x:Static res:Strings.AppTitle}" Style="{StaticResource MutedLabel}"
                           VerticalAlignment="Center" Margin="28,0,0,0" />

                <!--
                  Tab strip. A TabControl is the right control for "one of several screens" because Windows already knows
                  what it is: screen readers announce "tab, 3 of 8, selected", and the arrow keys, Home and End move the
                  selection with no code. We only borrow its tab STRIP: the template (PillTabControl in App.xaml) has no
                  content area, because the screens are shown by the ContentControl below, not inside the TabControl.
                  SelectedItem is two-way bound, so a click, an arrow key and a Ctrl+N shortcut all just set one property
                  on the view model. A ListBox or RadioButtons would look the same but announce themselves as a list or as
                  radio buttons, which is a worse description of what this is.
                -->
                <TabControl Grid.Column="1" Margin="28,0,0,0" VerticalAlignment="Center"
                            Style="{StaticResource PillTabControl}"
                            ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                            AutomationProperties.Name="{x:Static res:Strings.NavigationName}"
                            MouseLeftButtonDown="OnTabStripMouseDown">
                    <TabControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:NavigationItem}">
                            <TextBlock Text="{Binding Title}" />
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                </TabControl>

                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,14,0">
                    <!-- Icon-only buttons: ToolTip is for the mouse, AutomationProperties.Name is what screen readers announce. -->
                    <Button Style="{StaticResource WindowGlyphButton}" Click="OnMinimizeClick"
                            ToolTip="{x:Static res:Strings.MinimizeTooltip}"
                            AutomationProperties.Name="{x:Static res:Strings.MinimizeTooltip}">
                        <Path Data="{StaticResource MinimizeIcon}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                    <!-- Maximize and restore are one button: while maximized the glyph, tooltip and name all switch. -->
                    <Button Margin="4,0,0,0" Click="OnMaximizeClick">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource WindowGlyphButton}">
                                <Setter Property="ToolTip" Value="{x:Static res:Strings.MaximizeTooltip}" />
                                <Setter Property="AutomationProperties.Name" Value="{x:Static res:Strings.MaximizeTooltip}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Value="Maximized">
                                        <Setter Property="ToolTip" Value="{x:Static res:Strings.RestoreTooltip}" />
                                        <Setter Property="AutomationProperties.Name" Value="{x:Static res:Strings.RestoreTooltip}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" StrokeLineJoin="Round">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Data" Value="{StaticResource MaximizeIcon}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     Value="Maximized">
                                            <Setter Property="Data" Value="{StaticResource RestoreIcon}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>
                    <Button Margin="4,0,0,0" Style="{StaticResource CloseGlyphButton}" Click="OnCloseClick"
                            ToolTip="{x:Static res:Strings.CloseTooltip}"
                            AutomationProperties.Name="{x:Static res:Strings.CloseTooltip}">
                        <Path Data="{StaticResource CloseIcon}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Top bar: status pills on the left, actions on the right. It stays visible on every screen: the connection
                 status matters wherever you are. -->
            <!-- Tab order: the primary action first, then the title bar (tabs, window buttons). TabIndex only orders siblings
                 inside one keyboard-navigation scope, and a plain Grid (TabNavigation=Continue) does not form its own scope, so
                 its TabIndex was ignored and focus started on the title-bar glyphs. TabNavigation="Local" makes each bar a
                 tab group, which is what makes its TabIndex count (0 = this bar, 1 = the title bar). -->
            <Grid Grid.Row="1" Margin="28,4,28,12" KeyboardNavigation.TabIndex="0" KeyboardNavigation.TabNavigation="Local">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <!--
                      Connection pill. The dot color comes from a DataTrigger per ConnectionState: the view model
                      exposes a closed enum, the view decides which color means what. The base Setter keeps the dot
                      muted (Stopped); each trigger overrides it while its condition holds.
                    -->
                    <ContentControl Content="{Binding Status}" MaxWidth="560">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl" BasedOn="{StaticResource StatusPill}">
                                <Setter Property="Tag" Value="{StaticResource MutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ConnectionState}" Value="Receiving">
                                        <Setter Property="Tag" Value="{StaticResource ThrottleBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConnectionState}" Value="Listening">
                                        <Setter Property="Tag" Value="{StaticResource WarmBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConnectionState}" Value="NoData">
                                        <Setter Property="Tag" Value="{StaticResource WarmBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConnectionState}" Value="Error">
                                        <Setter Property="Tag" Value="{StaticResource BrakeBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                    <ContentControl Style="{StaticResource StatusPill}" Margin="10,0,0,0" Tag="{x:Null}"
                                    Content="{Binding PacketsPerSecond}"
                                    ContentStringFormat="{x:Static res:Strings.PacketsPerSecondPill}" />
                    <!-- Car info: class letter, performance index and drivetrain. Hidden until a packet carries a real car. -->
                    <ContentControl Style="{StaticResource StatusPill}" Margin="10,0,0,0" Tag="{x:Null}"
                                    Visibility="{Binding Dashboard.HasCarInfo, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Dashboard.CarClassLabel}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Dashboard.CarPerformanceIndex, StringFormat={x:Static res:Strings.CarPerformanceIndexFormat}}"
                                       Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0" />
                            <TextBlock Text="{Binding Dashboard.DrivetrainLabel}" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0" />
                        </StackPanel>
                    </ContentControl>
                </StackPanel>

                <!--
                  Right group: where to point the game (Data Out IP and port), then the primary action. Separate pills
                  instead of one "ip - port" string, so each value reads on its own. The text itself is a plain TextBlock (not
                  selectable), so the small button next to the IP copies it to the clipboard.
                -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ContentControl Style="{StaticResource StatusPill}" Tag="{x:Null}"
                                    AutomationProperties.Name="{x:Static res:Strings.DataOutIpLabel}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static res:Strings.DataOutIpLabel}" Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DataOut.Address}" Margin="8,0,0,0" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <!-- TabIndex 1: the Start/Stop toggle (TabIndex 0) stays the first tab stop of this bar. The command's
                                 CanExecute (an address exists) enables and disables the button by itself. -->
                            <Button Style="{StaticResource WindowGlyphButton}" Width="24" Height="24" Margin="6,0,-8,0" VerticalAlignment="Center"
                                    KeyboardNavigation.TabIndex="1" Command="{Binding DataOut.CopyAddressCommand}"
                                    ToolTip="{x:Static res:Strings.CopyIpTooltip}"
                                    AutomationProperties.Name="{x:Static res:Strings.CopyIpTooltip}">
                                <Path Data="{StaticResource CopyIcon}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.3" StrokeLineJoin="Round" />
                            </Button>
                        </StackPanel>
                    </ContentControl>
                    <ContentControl Style="{StaticResource StatusPill}" Margin="10,0,0,0" Tag="{x:Null}"
                                    Content="{Binding DataOut.Port}"
                                    ContentStringFormat="{x:Static res:Strings.DataOutPortPill}" />
                    <Button Style="{StaticResource ToggleListeningButton}" Margin="14,0,0,0" KeyboardNavigation.TabIndex="0"
                            Command="{Binding ToggleListeningCommand}">
                        <StackPanel Orientation="Horizontal">
                            <!-- Icon and label follow IsRunning; both read the button Foreground, which the style also switches. -->
                            <Path Margin="0,0,9,0" VerticalAlignment="Center" Stretch="None"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="{StaticResource PlayIcon}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Data" Value="{StaticResource StopIcon}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{x:Static res:Strings.StartButton}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Text" Value="{x:Static res:Strings.StopButton}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!--
              Page area. The ContentControl shows whatever object CurrentPage holds, and finds HOW to show it by looking for
              a DataTemplate whose DataType is that object's type (the implicit templates in Window.Resources). So
              navigating is just "CurrentPage = another view model": WPF throws away the old view and builds the new one,
              with the new view model already as its DataContext. Trade-off: a page's view is rebuilt on every visit
              (its on-screen-only state, like the G-force trail, starts fresh) while its view model, which holds the real
              state, lives on. Fine for these screens; a heavier one could cache its view.
              IsTabStop=False: the ContentControl itself is not a keyboard stop, only the controls inside the page are.
            -->
            <ContentControl Grid.Row="2" Content="{Binding CurrentPage}" IsTabStop="False" KeyboardNavigation.TabNavigation="Local"
                            KeyboardNavigation.TabIndex="2" />
        </Grid>
    </Border>
</Window>
