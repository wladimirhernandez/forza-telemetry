<Window x:Class="ForzaTelemetry.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ForzaTelemetry.App"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:MainViewModel, IsDesignTimeCreatable=True}"
        Title="Forza Telemetry" Width="420" Height="720" MinWidth="360" MinHeight="560">
    <!--
      Star-sized rows share the leftover height equally; Auto rows take only what their content needs.
      Every {Binding ...} below reads a property of MainViewModel (the DataContext set in MainWindow's constructor).
      StringFormat lives here in the view: the view model exposes plain numbers and the view decides how to show them.
    -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Gear: the biggest thing on screen, readable at a glance while driving. -->
        <TextBlock Grid.Row="0" Text="{Binding GearLabel}" FontSize="140" FontWeight="Bold"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />

        <TextBlock Grid.Row="1" Text="{Binding SpeedKmh, StringFormat={}{0:F0} km/h}" FontSize="64"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />

        <!-- Maximum is bound to MaxRpm: FH6 cars have very different redlines, so a fixed scale would be meaningless. -->
        <StackPanel Grid.Row="2" Margin="0,8,0,16">
            <ProgressBar Minimum="0" Maximum="{Binding MaxRpm}" Value="{Binding Rpm, Mode=OneWay}" Height="24" />
            <TextBlock Text="{Binding Rpm, StringFormat={}{0:F0} RPM}" HorizontalAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>

        <TextBlock Grid.Row="3" Text="{Binding PacketsPerSecond, StringFormat={}{0:F1} pkt/s}"
                   HorizontalAlignment="Center" Margin="0,0,0,8" />

        <TextBlock Grid.Row="4" Text="{Binding Status}" HorizontalAlignment="Center" TextWrapping="Wrap"
                   Margin="0,0,0,16" />

        <!-- Two buttons, each bound to one command: WPF enables/disables them from the command's CanExecute. -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Start" Command="{Binding StartCommand}" MinWidth="80" Margin="0,0,12,0" />
            <Button Content="Stop" Command="{Binding StopCommand}" MinWidth="80" />
        </StackPanel>
    </Grid>
</Window>
