<Application x:Class="ForzaTelemetry.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             xmlns:controls="clr-namespace:ForzaTelemetry.App.Controls"
             xmlns:res="clr-namespace:ForzaTelemetry.App.Resources"
             mc:Ignorable="po">
    <!-- No StartupUri: the composition root in App.xaml.cs (OnStartup) builds the services and creates the window. -->
    <!--
      Application.Resources is the app-wide resource dictionary: anything declared here is visible to every window.
      Everything below uses {StaticResource}: the lookup happens ONCE when the XAML loads, which is cheaper and
      catches typos at startup. {DynamicResource} re-resolves whenever the resource is replaced; we never swap the
      palette at runtime, so we do not pay for it.
      Order matters for StaticResource: a resource must be declared BEFORE the first thing that references it.
    -->
    <Application.Resources>
        <!-- Palette tokens. Controls reference the brushes below, never literal colors, so color only carries meaning. -->
        <Color x:Key="CanvasColor">#08090B</Color>
        <Color x:Key="CardColor">#16181C</Color>
        <Color x:Key="CardRaisedColor">#1E2126</Color>
        <Color x:Key="HairlineColor">#2A2E34</Color>
        <Color x:Key="TextColor">#E8EAED</Color>
        <Color x:Key="MutedColor">#8A9099</Color>
        <!-- Throttle doubles as "ideal / healthy"; Brake as "hot / redline / error". -->
        <Color x:Key="ThrottleColor">#3DDC84</Color>
        <Color x:Key="BrakeColor">#FF4D4F</Color>
        <Color x:Key="ColdColor">#3AA0FF</Color>
        <Color x:Key="WarmColor">#FFB020</Color>
        <!-- Primary button states: a lighter green on hover, a darker one when pressed. -->
        <Color x:Key="ThrottleHoverColor">#5CE79A</Color>
        <Color x:Key="ThrottlePressedColor">#2FB86B</Color>
        <!-- Danger button states (Record / Stop recording): the Brake red, lighter on hover and darker when pressed. -->
        <Color x:Key="BrakeHoverColor">#FF6B6D</Color>
        <Color x:Key="BrakePressedColor">#E03A3C</Color>
        <!-- Glyph on a red (Brake) hover fill, e.g. the close button. -->
        <Color x:Key="OnAlertColor">#FFFFFF</Color>

        <SolidColorBrush po:Freeze="True" x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
        <SolidColorBrush po:Freeze="True" x:Key="CardBrush" Color="{StaticResource CardColor}" />
        <SolidColorBrush po:Freeze="True" x:Key="CardRaisedBrush" Color="{StaticResource CardRaisedColor}" />
        <SolidColorBrush po:Freeze="True" x:Key="HairlineBrush" Color="{StaticResource HairlineColor}" />
        <SolidColorBrush po:Freeze="True" x:Key="TextBrush" Color="{StaticResource TextColor}" />
        <SolidColorBrush po:Freeze="True" x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
        <SolidColorBrush po:Freeze="True" x:Key="ThrottleBrush" Color="{StaticResource ThrottleColor}" />
        <SolidColorBrush po:Freeze="True" x:Key="BrakeBrush" Color="{StaticResource BrakeColor}" />
        <SolidColorBrush po:Freeze="True" x:Key="ColdBrush" Color="{StaticResource ColdColor}" />
        <SolidColorBrush po:Freeze="True" x:Key="WarmBrush" Color="{StaticResource WarmColor}" />
        <SolidColorBrush po:Freeze="True" x:Key="OnAlertBrush" Color="{StaticResource OnAlertColor}" />

        <!-- Fonts: a comma list is a fallback chain. Bahnschrift (DIN-based) ships with Windows 10+. -->
        <FontFamily x:Key="NumeralFont">Bahnschrift Light, Bahnschrift</FontFamily>
        <FontFamily x:Key="LabelFont">Segoe UI Variable Text, Segoe UI</FontFamily>

        <!-- Corner radius hierarchy: window 16, cards 14, buttons 10, pills fully rounded. -->
        <CornerRadius x:Key="WindowRadius">16</CornerRadius>
        <CornerRadius x:Key="CardRadius">14</CornerRadius>
        <CornerRadius x:Key="ButtonRadius">10</CornerRadius>
        <CornerRadius x:Key="PillRadius">999</CornerRadius>
        <!--
          Border corner radii must be explicit when a pill is wide: WPF scales a too-large radius down by width, which turns
          a long pill into a lens shape (PillRadius only looks right on short, near-square shapes). ControlPillRadius is
          ControlHeight / 2 = 18: the status pills and the tab strip; a tab inside the strip is that minus its 1 px border
          and 3 px padding = 14.
        -->
        <CornerRadius x:Key="ControlPillRadius">18</CornerRadius>
        <CornerRadius x:Key="TabRadius">14</CornerRadius>
        <!-- Focus ring sits 3 px outside a button face, so its radius is ButtonRadius + 3 (XAML cannot add, so it is a token). -->
        <system:Double x:Key="FocusRingRadius" xmlns:system="clr-namespace:System;assembly=System.Runtime">13</system:Double>
        <!-- One height for everything on the top bar (pills and the Start/Stop button) so they align on one line. -->
        <system:Double x:Key="ControlHeight" xmlns:system="clr-namespace:System;assembly=System.Runtime">36</system:Double>

        <!--
          Transparent margin around the window card: it is where the drop shadow is drawn AND the size of the
          invisible resize band (WindowChrome.ResizeBorderThickness). One resource feeds both, so they cannot drift.
          MainWindow zeroes both while maximized.
        -->
        <Thickness x:Key="ChromeMargin">12</Thickness>

        <!-- Window glyphs as vector geometry: crisp at any DPI and they take the button foreground color. -->
        <Geometry x:Key="MinimizeIcon">M 0,6 H 12</Geometry>
        <Geometry x:Key="MaximizeIcon">M 1,1 H 11 V 11 H 1 Z</Geometry>
        <Geometry x:Key="RestoreIcon">M 3,3 V 1 H 11 V 9 H 9 M 1,3 H 9 V 11 H 1 Z</Geometry>
        <Geometry x:Key="CloseIcon">M 1,1 L 11,11 M 11,1 L 1,11</Geometry>
        <Geometry x:Key="CopyIcon">M 4,0.5 H 11.5 V 8 H 4 Z M 2,3.5 H 0.5 V 11.5 H 8 V 10</Geometry>
        <Geometry x:Key="PlayIcon">M 1,0 L 11,6 L 1,12 Z</Geometry>
        <Geometry x:Key="StopIcon">M 1,1 H 11 V 11 H 1 Z</Geometry>
        <Geometry x:Key="PauseIcon">M 1,0 H 4.2 V 12 H 1 Z M 7.8,0 H 11 V 12 H 7.8 Z</Geometry>
        <Geometry x:Key="RecordIcon">M 0,6 A 6,6 0 1 0 12,6 A 6,6 0 1 0 0,6 Z</Geometry>
        <!-- Outline glyphs (stroke, ~12 x 12 box) for the recordings list. -->
        <Geometry x:Key="RestartIcon">M 1.2,6 A 4.8,4.8 0 1 1 2.6,9.4 M 1.2,1.6 V 6 H 5.6</Geometry>
        <Geometry x:Key="PencilIcon">M 1,11 L 1.6,8.4 L 8.6,1.4 L 10.6,3.4 L 3.6,10.4 Z M 7.2,2.8 L 9.2,4.8</Geometry>
        <Geometry x:Key="TrashIcon">M 1,3 H 11 M 4.2,3 V 1 H 7.8 V 3 M 2.4,3 L 3.1,11 H 8.9 L 9.6,3 M 5,5.4 V 8.6 M 7,5.4 V 8.6</Geometry>
        <Geometry x:Key="FolderIcon">M 0.8,2.4 H 4.6 L 5.8,3.8 H 11.2 V 10.4 H 0.8 Z</Geometry>
        <!-- An arrow dropping into a tray: "save this out as a file" (the Export CSV buttons). -->
        <Geometry x:Key="ExportIcon">M 6,0.8 V 7.6 M 3,4.8 L 6,7.8 L 9,4.8 M 1,10.8 H 11</Geometry>

        <!-- Card surface: a dark rounded panel with a hairline border. -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
            <Setter Property="Padding" Value="22" />
        </Style>

        <!-- Text roles. A keyed TextBlock style must be applied explicitly with Style="{StaticResource ...}". -->
        <Style x:Key="MutedLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource LabelFont}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource LabelFont}" />
            <Setter Property="FontSize" Value="20" />
        </Style>

        <!-- Big thin numerals. Override FontSize at the use site: ~96 gear, ~72 speed, ~40 panel numerals. -->
        <Style x:Key="NumeralText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource NumeralFont}" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="FontSize" Value="40" />
        </Style>

        <!--
          Status pill: a ContentControl with a custom ControlTemplate. A ControlTemplate replaces a control's whole
          visual tree while keeping its behavior; the template is where "Border + dot + text" is defined once.
          {TemplateBinding Tag} feeds the dot color from the use site (Tag is a general-purpose slot on every
          element), so a pill needs no code and no new control class. Tag = null hides the dot.
        -->
        <Style x:Key="StatusPill" TargetType="ContentControl">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource LabelFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Height" Value="{StaticResource ControlHeight}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource HairlineBrush}"
                                BorderThickness="1" CornerRadius="{StaticResource ControlPillRadius}" Padding="14,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="Dot" Width="8" Height="8" Margin="0,1,8,0" VerticalAlignment="Center"
                                         Fill="{TemplateBinding Tag}" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Triggers apply a set of Setters while a condition holds, and undo them when it stops. -->
                            <Trigger Property="Tag" Value="{x:Null}">
                                <Setter TargetName="Dot" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          Keyboard focus ring. FocusVisualStyle is the WPF hook for "draw something around the control that has KEYBOARD
          focus": WPF shows it only when focus arrived through Tab/arrow keys, never after a mouse click, which is the
          behavior we want (a ring that also appeared after every click would be visual noise). It is drawn in an
          adorner layer ABOVE the control, so it is not clipped by the button and needs no space in the template. The
          negative margin pushes it 3 px outside the face; its radius is the button radius plus that 3 px.
        -->
        <Style x:Key="FocusRing">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-3" Stroke="{StaticResource TextBrush}" StrokeThickness="2"
                                   RadiusX="{StaticResource FocusRingRadius}" RadiusY="{StaticResource FocusRingRadius}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          Button state transitions use the VisualStateManager (VSM) instead of Triggers. A Trigger flips a property
          instantly; the VSM can play a short animation while it moves between named states, and
          <VisualTransition GeneratedDuration="0:0:0.12"/> asks WPF to generate that ~120 ms blend for EVERY pair of
          states, including "back to Normal", so no storyboard has to be written for the way back. The brushes being
          animated must be LOCAL to the template (each button owns its SolidColorBrush): the shared token brushes are
          frozen (read-only, shared by the whole app), and animating a shared brush would repaint every user of it.
        -->

        <!-- Filled green action: lighter green on hover, darker green when pressed (no white wash over the face). -->
        <ControlTemplate x:Key="PrimaryButtonTemplate" TargetType="Button">
            <Border x:Name="Face" CornerRadius="{StaticResource ButtonRadius}" Padding="{TemplateBinding Padding}">
                <Border.Background>
                    <SolidColorBrush Color="{StaticResource ThrottleColor}" />
                </Border.Background>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualStateGroup.Transitions>
                            <VisualTransition GeneratedDuration="0:0:0.12" />
                        </VisualStateGroup.Transitions>
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="MouseOver">
                            <Storyboard>
                                <ColorAnimation Storyboard.TargetName="Face" Storyboard.TargetProperty="Background.Color"
                                                To="{StaticResource ThrottleHoverColor}" Duration="0" />
                            </Storyboard>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <Storyboard>
                                <ColorAnimation Storyboard.TargetName="Face" Storyboard.TargetProperty="Background.Color"
                                                To="{StaticResource ThrottlePressedColor}" Duration="0" />
                            </Storyboard>
                        </VisualState>
                        <VisualState x:Name="Disabled">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Face" Storyboard.TargetProperty="Opacity"
                                                 To="0.4" Duration="0" />
                            </Storyboard>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
        </ControlTemplate>

        <!--
          Outlined secondary action. Hover/pressed are two "fill" layers whose Opacity is animated 0 to 1 (animating
          opacity needs no local brush and no literal colors: the layers use the shared tokens).
        -->
        <ControlTemplate x:Key="GhostButtonTemplate" TargetType="Button">
            <Border x:Name="Face" Background="Transparent" BorderBrush="{StaticResource HairlineBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource ButtonRadius}">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualStateGroup.Transitions>
                            <VisualTransition GeneratedDuration="0:0:0.12" />
                        </VisualStateGroup.Transitions>
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="MouseOver">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0" />
                            </Storyboard>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0" />
                                <DoubleAnimation Storyboard.TargetName="PressShade" Storyboard.TargetProperty="Opacity"
                                                 To="0.35" Duration="0" />
                            </Storyboard>
                        </VisualState>
                        <VisualState x:Name="Disabled">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Face" Storyboard.TargetProperty="Opacity"
                                                 To="0.4" Duration="0" />
                            </Storyboard>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Grid>
                    <Border x:Name="HoverFill" Background="{StaticResource CardRaisedBrush}" Opacity="0"
                            CornerRadius="{StaticResource ButtonRadius}" />
                    <Border x:Name="PressShade" Background="{StaticResource CanvasBrush}" Opacity="0"
                            CornerRadius="{StaticResource ButtonRadius}" />
                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                      VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                </Grid>
            </Border>
        </ControlTemplate>

        <!-- Filled red action (the same states as the green primary, with the Brake family): Stop recording. -->
        <ControlTemplate x:Key="DangerButtonTemplate" TargetType="Button">
            <Border x:Name="Face" CornerRadius="{StaticResource ButtonRadius}" Padding="{TemplateBinding Padding}">
                <Border.Background>
                    <SolidColorBrush Color="{StaticResource BrakeColor}" />
                </Border.Background>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualStateGroup.Transitions>
                            <VisualTransition GeneratedDuration="0:0:0.12" />
                        </VisualStateGroup.Transitions>
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="MouseOver">
                            <Storyboard>
                                <ColorAnimation Storyboard.TargetName="Face" Storyboard.TargetProperty="Background.Color"
                                                To="{StaticResource BrakeHoverColor}" Duration="0" />
                            </Storyboard>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <Storyboard>
                                <ColorAnimation Storyboard.TargetName="Face" Storyboard.TargetProperty="Background.Color"
                                                To="{StaticResource BrakePressedColor}" Duration="0" />
                            </Storyboard>
                        </VisualState>
                        <VisualState x:Name="Disabled">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Face" Storyboard.TargetProperty="Opacity"
                                                 To="0.4" Duration="0" />
                            </Storyboard>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
        </ControlTemplate>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource CanvasBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource LabelFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="22,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template" Value="{StaticResource PrimaryButtonTemplate}" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource LabelFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="22,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template" Value="{StaticResource GhostButtonTemplate}" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--
          Shared by every screen that shows a bool as visible/collapsed, declared once here so a view does not carry its own copy.
          The form-control styles below are the same idea: a ghost button at the standard control height, and the two paragraph
          roles of the cards (small print and body text). They sit here, after the styles they build on, for the same reason.
        -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- A secondary action inside a card or dialog. Left-aligned by default (it must not stretch across a vertical panel). -->
        <Style x:Key="FormButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Height" Value="{StaticResource ControlHeight}" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style x:Key="SmallNote" TargetType="TextBlock" BasedOn="{StaticResource MutedLabel}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="18" />
        </Style>

        <!--
          The one-line result next to an Export button. Its DataContext is the page's ExportFeedback (set where it is used), so the
          bindings below are relative to it: red when it reports a failure, collapsed while there is nothing to say, and a polite
          live region so a screen reader announces "Saved ..." without the user having to look for it.
        -->
        <Style x:Key="ExportNote" TargetType="TextBlock" BasedOn="{StaticResource MutedLabel}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MaxWidth" Value="480" />
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Text" Value="{Binding Text}" />
            <Setter Property="ToolTip" Value="{Binding Tooltip}" />
            <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource BrakeBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasText}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource LabelFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="20" />
        </Style>

        <!--
          ONE button for Start and Stop. A DataTrigger on the view model's IsRunning swaps the whole Template (green
          primary while stopped, neutral outline while running) and the foreground that goes with it. The label and
          the icon are switched the same way at the use site, so the view model needs no "button text" property.
        -->
        <Style x:Key="ToggleListeningButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Height" Value="{StaticResource ControlHeight}" />
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <!-- The content is a panel (icon + text), so give screen readers the label explicitly. -->
            <Setter Property="AutomationProperties.Name" Value="{x:Static res:Strings.StartButton}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter Property="AutomationProperties.Name" Value="{x:Static res:Strings.StopButton}" />
                    <Setter Property="Template" Value="{StaticResource GhostButtonTemplate}" />
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </DataTrigger>
                <!-- Declared after IsRunning (a replay is also "running"), so while replaying this one wins. -->
                <DataTrigger Binding="{Binding IsReplaying}" Value="True">
                    <Setter Property="AutomationProperties.Name" Value="{x:Static res:Strings.StopReplayButton}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Focus ring for fully rounded (pill) shapes: a Rectangle clamps a huge radius to half its height. -->
        <Style x:Key="PillFocusRing">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-3" Stroke="{StaticResource TextBrush}" StrokeThickness="2" RadiusX="999" RadiusY="999" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          One tab of the top navigation (a segmented pill). Two fill layers sit under the label: HoverFill (a quieter
          raised surface while the mouse is over an unselected tab) and SelectedFill (the raised surface plus a hairline
          for the selected tab). The VisualStateManager fades their Opacity (~120 ms, same as the buttons); the label
          color is a plain Trigger (instant), Muted normally and Text when selected or hovered.
          A TabItem reports two independent state groups: CommonStates (hover) and SelectionStates (selected), which is
          why both can be active at once (hovering the selected tab).
        -->
        <ControlTemplate x:Key="PillTabItemTemplate" TargetType="TabItem">
            <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualStateGroup.Transitions>
                            <VisualTransition GeneratedDuration="0:0:0.12" />
                        </VisualStateGroup.Transitions>
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="MouseOver">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity"
                                                 To="0.6" Duration="0" />
                            </Storyboard>
                        </VisualState>
                        <VisualState x:Name="Disabled">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity"
                                                 To="0.4" Duration="0" />
                            </Storyboard>
                        </VisualState>
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="SelectionStates">
                        <VisualStateGroup.Transitions>
                            <VisualTransition GeneratedDuration="0:0:0.12" />
                        </VisualStateGroup.Transitions>
                        <VisualState x:Name="Unselected" />
                        <VisualState x:Name="Selected">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="SelectedFill" Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0" />
                            </Storyboard>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Border x:Name="HoverFill" Background="{StaticResource CardRaisedBrush}" Opacity="0"
                        CornerRadius="{StaticResource TabRadius}" />
                <Border x:Name="SelectedFill" Background="{StaticResource CardRaisedBrush}" BorderBrush="{StaticResource HairlineBrush}"
                        BorderThickness="1" Opacity="0" CornerRadius="{StaticResource TabRadius}" />
                <ContentPresenter ContentSource="Header" Margin="16,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!--
          The tab container's style. The three Automation setters read the NavigationItem the tab was generated from
          (a container's DataContext is its item): the name a screen reader says, the shortcut it announces, and the
          tooltip text.
        -->
        <Style x:Key="PillTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource LabelFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource PillFocusRing}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <Setter Property="AutomationProperties.AcceleratorKey" Value="{Binding Shortcut}" />
            <Setter Property="ToolTip" Value="{Binding ToolTip}" />
            <Setter Property="Template" Value="{StaticResource PillTabItemTemplate}" />
        </Style>

        <!--
          The tab strip: a pill-shaped card holding the tabs side by side. The template has NO content host
          (PART_SelectedContentHost): this TabControl only draws the strip, the app shows the screens elsewhere.
          KeyboardNavigation: TabControl already enters the strip with Tab (one stop, the selected tab) and moves with
          the arrow keys, Home and End, so nothing else is needed for keyboard use.
        -->
        <Style x:Key="PillTabControl" TargetType="TabControl">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
            <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
            <Setter Property="Height" Value="{StaticResource ControlHeight}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource PillTabItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource HairlineBrush}"
                                BorderThickness="1" CornerRadius="{StaticResource ControlPillRadius}" Padding="3">
                            <StackPanel IsItemsHost="True" Orientation="Horizontal" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          Title bar glyph button (minimize, maximize, close). The glyph Path reads the button's Foreground.
          Tag carries the hover fill brush (a general-purpose slot, like the status pill's dot color), so the close
          button reuses this template with a red fill instead of duplicating it.
        -->
        <ControlTemplate x:Key="GlyphButtonTemplate" TargetType="Button">
            <Border x:Name="Face" Background="Transparent" CornerRadius="{StaticResource ButtonRadius}">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualStateGroup.Transitions>
                            <VisualTransition GeneratedDuration="0:0:0.12" />
                        </VisualStateGroup.Transitions>
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="MouseOver">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0" />
                            </Storyboard>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0" />
                                <DoubleAnimation Storyboard.TargetName="PressShade" Storyboard.TargetProperty="Opacity"
                                                 To="0.35" Duration="0" />
                            </Storyboard>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Grid>
                    <Border x:Name="HoverFill" Background="{TemplateBinding Tag}" Opacity="0"
                            CornerRadius="{StaticResource ButtonRadius}" />
                    <Border x:Name="PressShade" Background="{StaticResource CanvasBrush}" Opacity="0"
                            CornerRadius="{StaticResource ButtonRadius}" />
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </ControlTemplate>

        <Style x:Key="WindowGlyphButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Tag" Value="{StaticResource CardRaisedBrush}" />
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template" Value="{StaticResource GlyphButtonTemplate}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </Trigger>
                <!-- A glyph button that cannot be used (a command that cannot run) must look it, not just ignore clicks. -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Windows convention: the close button turns red on hover and its glyph turns white. -->
        <Style x:Key="CloseGlyphButton" TargetType="Button" BasedOn="{StaticResource WindowGlyphButton}">
            <Setter Property="Tag" Value="{StaticResource BrakeBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource OnAlertBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===== Form controls (Settings screen) ===== -->

        <!-- Section heading inside a card. -->
        <!--
          Text link: a borderless button for "go somewhere or open something" inside a sentence-sized space (the dashboard's
          "How to connect"). The green label and a 1 px underline that fades in on hover and keyboard focus say it is clickable
          without the weight of a filled button. The underline is an opacity layer, like the Ghost button's fills, so no color is animated.
        -->
        <ControlTemplate x:Key="LinkButtonTemplate" TargetType="Button">
            <Grid Background="Transparent" Margin="{TemplateBinding Padding}">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualStateGroup.Transitions>
                            <VisualTransition GeneratedDuration="0:0:0.12" />
                        </VisualStateGroup.Transitions>
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="MouseOver">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Underline" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                            </Storyboard>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Underline" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                <DoubleAnimation Storyboard.TargetName="Label" Storyboard.TargetProperty="Opacity" To="0.7" Duration="0" />
                            </Storyboard>
                        </VisualState>
                        <VisualState x:Name="Disabled">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Label" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0" />
                            </Storyboard>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <ContentPresenter x:Name="Label" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                <Border x:Name="Underline" Height="1" VerticalAlignment="Bottom" Margin="0,0,0,-2" Opacity="0"
                        Background="{TemplateBinding Foreground}" />
            </Grid>
        </ControlTemplate>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource ThrottleBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource LabelFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template" Value="{StaticResource LinkButtonTemplate}" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource LabelFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!--
          Scrollbar: thin, dark, no arrow buttons, a rounded thumb that brightens on hover/drag. An implicit style (no x:Key)
          restyles EVERY ScrollBar in the app, including the ones inside ScrollViewers and the combo box popup. A ScrollBar's
          template must contain a Track named PART_Track: the Track lays out the thumb and the two page buttons for us.
        -->
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Pill" Background="{StaticResource MutedBrush}" Opacity="0.45" CornerRadius="4" Margin="2" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Pill" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The page-up/page-down areas of the track: invisible but clickable. -->
        <Style x:Key="ScrollTrackButton" TargetType="RepeatButton">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="PageDecrease" Style="{StaticResource ScrollTrackButton}"
                                                  Command="{x:Static ScrollBar.PageUpCommand}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton x:Name="PageIncrease" Style="{StaticResource ScrollTrackButton}"
                                                  Command="{x:Static ScrollBar.PageDownCommand}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="Orientation" Value="Horizontal" />
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                                <Setter TargetName="PageDecrease" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}" />
                                <Setter TargetName="PageIncrease" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="12" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--
          Text input. The template draws a rounded border around a ScrollViewer named PART_ContentHost, which is where a
          TextBox puts the editable text (it MUST be named so). The border color is the only state signal: hairline at rest,
          muted on hover, bright while focused, red when Tag is True (the Settings screen binds Tag to "has an error").
          A focused TextBox also gets the OS caret and selection, themed through CaretBrush / SelectionBrush.
        -->
        <Style x:Key="InputTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource ThrottleBrush}" />
            <Setter Property="SelectionOpacity" Value="0.35" />
            <Setter Property="FontFamily" Value="{StaticResource LabelFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Height" Value="{StaticResource ControlHeight}" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="Box" Background="{StaticResource CardRaisedBrush}" BorderBrush="{StaticResource HairlineBrush}"
                                    BorderThickness="1" CornerRadius="{StaticResource ButtonRadius}" Padding="{TemplateBinding Padding}">
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                            </Border>
                            <!-- The error outline is its own layer ON TOP of the box instead of a BorderBrush trigger: a focused box
                                 (the state a box is always in while the user is typing an invalid value) kept its white focus border,
                                 so the red never showed exactly when it mattered. A layer cannot lose that race. -->
                            <Border x:Name="ErrorRing" BorderBrush="{StaticResource BrakeBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource ButtonRadius}" Visibility="Collapsed" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource MutedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="Tag">
                                <Trigger.Value>
                                    <!-- A real Boolean: Tag is typed object, so the string "True" would never equal a bool that is True. -->
                                    <system:Boolean xmlns:system="clr-namespace:System;assembly=System.Runtime">True</system:Boolean>
                                </Trigger.Value>
                                <Setter TargetName="ErrorRing" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          Segmented choice (a pill with one segment per option, one selected): a ListBox restyled. A ListBox already gives
          single selection, arrow-key movement with selection following focus, and the UI Automation "selection" pattern,
          and it is data-driven (ItemsSource of ChoiceOption), so the view model needs no per-option bool properties and
          the XAML needs no converters. RadioButtons would announce as radio buttons but need one of those two workarounds.
          The segment look matches the tab strip.
        -->
        <Style x:Key="SegmentedListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource LabelFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource PillFocusRing}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.12" />
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity"
                                                             To="0.6" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                                <!-- A ListBoxItem reports "SelectedUnfocused" instead of "Selected" while the list does not have focus. -->
                                <VisualStateGroup x:Name="SelectionStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.12" />
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Unselected" />
                                    <VisualState x:Name="Selected">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SelectedFill" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="SelectedUnfocused">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SelectedFill" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="HoverFill" Background="{StaticResource CardRaisedBrush}" Opacity="0"
                                    CornerRadius="{StaticResource TabRadius}" />
                            <Border x:Name="SelectedFill" Background="{StaticResource CardRaisedBrush}" BorderBrush="{StaticResource HairlineBrush}"
                                    BorderThickness="1" Opacity="0" CornerRadius="{StaticResource TabRadius}" />
                            <ContentPresenter Margin="16,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentedListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="{StaticResource ControlHeight}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
            <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
            <Setter Property="SelectedValuePath" Value="Value" />
            <Setter Property="DisplayMemberPath" Value="Label" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource SegmentedListBoxItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource HairlineBrush}"
                                BorderThickness="1" CornerRadius="{StaticResource ControlPillRadius}" Padding="3">
                            <StackPanel IsItemsHost="True" Orientation="Horizontal" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          Modern on/off switch: a CheckBox with a different template. A CheckBox already is "a two-state control" to Windows
          (keyboard Space toggles it, screen readers say "toggle button, on/off"), so only the look changes. The thumb slides
          by animating the X of a TranslateTransform when the control enters the Checked state; the green "on" track is a
          second layer whose Opacity is faded. The label is NOT inside the control: the screen puts text beside it and sets
          AutomationProperties.Name so assistive technology still gets a name.
        -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource PillFocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="42" Height="24" Background="Transparent" SnapsToDevicePixels="True">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.15" />
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Indeterminate" />
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="OnTrack" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0" />
                                            <DoubleAnimation Storyboard.TargetName="ThumbMove" Storyboard.TargetProperty="X"
                                                             To="18" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.12" />
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed" />
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity"
                                                             To="0.4" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid x:Name="Root">
                                <Border Background="{StaticResource HairlineBrush}" CornerRadius="12" />
                                <Border x:Name="Hover" Background="{StaticResource MutedBrush}" Opacity="0" CornerRadius="12" />
                                <Border x:Name="OnTrack" Background="{StaticResource ThrottleBrush}" Opacity="0" CornerRadius="12" />
                                <Ellipse Width="18" Height="18" Margin="3,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                         Fill="{StaticResource TextBrush}">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="ThumbMove" X="0" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          Combo box (dropdown list), themed. A ComboBox template needs four things: a ToggleButton bound two-way to
          IsDropDownOpen (the closed box that opens the list), a ContentPresenter bound to SelectionBoxItem (the chosen
          item's text), a Popup named PART_Popup (the list, in its own window so it can overhang the page) and an
          ItemsPresenter inside it (the items). The items themselves are styled by ComboBoxItem below.
        -->
        <ControlTemplate x:Key="ComboToggleTemplate" TargetType="ToggleButton">
            <Border x:Name="Box" Background="{StaticResource CardRaisedBrush}" BorderBrush="{StaticResource HairlineBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource ButtonRadius}">
                <Path x:Name="Chevron" Data="M 0,0 L 5,5 L 10,0" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource MutedBrush}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource TextBrush}" />
                    <Setter TargetName="Chevron" Property="Stroke" Value="{StaticResource TextBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource LabelFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" />
                                <!-- A tick on the item that is currently chosen. -->
                                <Path x:Name="Tick" Data="M 0,5 L 4,9 L 12,1" Stroke="{StaticResource ThrottleBrush}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- IsHighlighted covers both the mouse and the arrow keys moving through the open list. -->
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource CardRaisedBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource LabelFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Height" Value="{StaticResource ControlHeight}" />
            <Setter Property="SelectedValuePath" Value="Value" />
            <!-- An explicit item template (instead of DisplayMemberPath) so the closed box and the open list both show the Label text. -->
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="Root">
                            <ToggleButton Template="{StaticResource ComboToggleTemplate}" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              Margin="14,0,38,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                              IsHitTestVisible="False" />
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <!-- The transparent margin around the card is where its drop shadow is drawn. -->
                                <Grid MinWidth="{Binding ActualWidth, ElementName=Root}" Margin="12,2,12,14">
                                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource HairlineBrush}"
                                            BorderThickness="1" CornerRadius="{StaticResource ButtonRadius}" Padding="4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.5" Color="Black" />
                                        </Border.Effect>
                                        <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          Thin progress bar. ProgressBar's template must contain elements named PART_Track and PART_Indicator:
          the control resizes PART_Indicator to (Value / Maximum) of PART_Track's width by itself.
        -->
        <Style x:Key="ThinProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Foreground" Value="{StaticResource ThrottleBrush}" />
            <Setter Property="Background" Value="{StaticResource HairlineBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="PART_Track">
                            <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" CornerRadius="3" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Thin leader line from a callout card to its wheel. -->
        <Style x:Key="LeaderLine" TargetType="Line">
            <Setter Property="Stroke" Value="{StaticResource MutedBrush}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>

        <!--
          Fill that follows a tire temperature band. The shape's DataContext must be a TireViewModel. Hairline is
          the "no data yet" color. Steps (not a blend) keep each color meaningful: you read "green = ideal".
        -->
        <Style x:Key="TireBandShape" TargetType="Shape">
            <Setter Property="Fill" Value="{StaticResource HairlineBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Band}" Value="Cold">
                    <Setter Property="Fill" Value="{StaticResource ColdBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Band}" Value="Ideal">
                    <Setter Property="Fill" Value="{StaticResource ThrottleBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Band}" Value="Warm">
                    <Setter Property="Fill" Value="{StaticResource WarmBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Band}" Value="Hot">
                    <Setter Property="Fill" Value="{StaticResource BrakeBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
          Tire callout card. DataContext = a TireViewModel (set at the use site), Tag = the card title.
          Fixed 190 x 104 so the leader lines in the car canvas can be computed from it.
        -->
        <Style x:Key="TireCallout" TargetType="ContentControl">
            <Setter Property="Width" Value="190" />
            <Setter Property="Height" Value="104" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border Background="{StaticResource CardRaisedBrush}" BorderBrush="{StaticResource HairlineBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="14,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Margin="0,1,7,0" Style="{StaticResource TireBandShape}" />
                                    <TextBlock Text="{TemplateBinding Tag}" Style="{StaticResource MutedLabel}" FontSize="12" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TemperatureReadout}" Style="{StaticResource NumeralText}" FontSize="34" />
                                    <TextBlock Text="{Binding TemperatureUnitLabel}" Style="{StaticResource MutedLabel}"
                                               Margin="4,0,0,5" VerticalAlignment="Bottom" />
                                    <TextBlock Style="{StaticResource MutedLabel}" FontSize="12" Margin="12,0,0,6" VerticalAlignment="Bottom">
                                        <Run Text="{x:Static res:Strings.TireSlipLabel}" />
                                        <Run Text="{Binding Slip, Mode=OneWay, StringFormat={}{0:F2}}" Foreground="{StaticResource TextBrush}" />
                                    </TextBlock>
                                </StackPanel>
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Static res:Strings.TireSuspensionLabel}" Style="{StaticResource MutedLabel}"
                                               FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="1" Style="{StaticResource ThinProgressBar}" Height="4"
                                                 Foreground="{StaticResource MutedBrush}" Minimum="0" Maximum="1"
                                                 Value="{Binding Suspension, Mode=OneWay}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          Default look of the custom drawing controls. A Style WITHOUT x:Key and with a TargetType is an implicit style:
          WPF applies it to every element of exactly that type, so the XAML that uses a control only sets data
          (Value, Maximum, ...) and never repeats brushes. The brushes are the frozen tokens above, which is also what
          lets the controls freeze their pens (see RenderHelpers.CreatePen).
        -->
        <Style TargetType="controls:ShiftLightStrip">
            <Setter Property="LowBrush" Value="{StaticResource ThrottleBrush}" />
            <Setter Property="MidBrush" Value="{StaticResource WarmBrush}" />
            <Setter Property="HighBrush" Value="{StaticResource BrakeBrush}" />
            <Setter Property="OffBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style TargetType="controls:GForceMeter">
            <Setter Property="RingBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="DotBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style TargetType="controls:BarMeter">
            <Setter Property="TrackBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="FillBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style TargetType="controls:TickGauge">
            <Setter Property="TrackBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="FillBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </Application.Resources>
</Application>
