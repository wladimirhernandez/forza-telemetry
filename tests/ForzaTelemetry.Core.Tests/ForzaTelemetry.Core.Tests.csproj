    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ForzaTelemetry.Core\ForzaTelemetry.Core.csproj" />
  </ItemGroup>

</Project>
